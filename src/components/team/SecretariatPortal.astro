---
const { view, endpoint, apiKey } = Astro.props;
const isLogin = view === 'login';
---

<main class="secretariat" data-secretariat data-view={view} data-endpoint={endpoint} data-api-key={apiKey} data-inbox-path="/secretariat/inbox" data-login-path="/secretariat">
  {isLogin ? (
    <>
      <section class="secretariat__hero">
        <span class="section-index">PRIVATE TEAM ACCESS</span>
        <h1>Registration Responses</h1>
      </section>
      <section class="secretariat__panel secretariat__panel--login" aria-labelledby="secretariat-title">
        <div><span class="section-index">SECRETARIAT</span><h2 id="secretariat-title">Team sign in</h2></div>
        <form class="secretariat__login" data-login>
          <label>Email<input type="email" name="email" autocomplete="username" required /></label>
          <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
          <button class="button button--ember" type="submit">Sign in</button>
        </form>
        <p class="secretariat__status" data-status role="status" aria-live="polite"></p>
      </section>
    </>
  ) : (
    <section class="secretariat__panel" aria-labelledby="secretariat-title">
      <div class="secretariat__heading">
        <div><span class="section-index">SECRETARIAT</span><h1 id="secretariat-title">Registration Responses</h1></div>
        <button class="button button--outline" type="button" data-logout>Sign out</button>
      </div>
      <p class="secretariat__status" data-status role="status" aria-live="polite">Checking your Secretariat access…</p>
      <div class="secretariat__records" data-records hidden>
        <div class="secretariat__tabs" role="tablist" aria-label="Registration form responses">
          <button type="button" role="tab" id="tab-pastors" aria-label="Pastors and Ministry Heads" aria-controls="registration-records" aria-selected="true" data-reg-tab="pastors"><span class="tab-label--full">Pastors &amp; Ministry Heads</span><span class="tab-label--short">Pastors</span></button>
          <button type="button" role="tab" id="tab-campus" aria-label="Campus Leaders" aria-controls="registration-records" aria-selected="false" data-reg-tab="campus"><span class="tab-label--full">Campus Leaders</span><span class="tab-label--short">Campus</span></button>
          <button type="button" role="tab" id="tab-delegates" aria-label="Delegates" aria-controls="registration-records" aria-selected="false" data-reg-tab="delegates"><span class="tab-label--full">Delegates</span><span class="tab-label--short">Delegates</span></button>
          <button type="button" role="tab" id="tab-viewing" aria-label="Viewing centre hosts" aria-controls="registration-records" aria-selected="false" data-reg-tab="viewing"><span class="tab-label--full">Viewing Centres</span><span class="tab-label--short">Hosts</span></button>
        </div>
        <div class="secretariat__filters" aria-label="Filter registration responses">
          <label>Search<input type="search" placeholder="Search names, contacts, or responses" data-search /></label>
          <label>From<input type="date" data-date-from /></label>
          <label>To<input type="date" data-date-to /></label>
        </div>
        <div class="secretariat__toolbar"><label class="secretariat__select-all"><input type="checkbox" data-select-all /> Select all matching</label><div class="secretariat__actions"><button class="button button--ember" type="button" data-download>Download all matching</button></div></div>
        <div class="secretariat__table-wrap" id="registration-records" role="tabpanel" aria-labelledby="tab-pastors" tabindex="0"><table><thead data-head></thead><tbody data-rows></tbody></table></div>
      </div>
    </section>
  )}
</main>

<script src="../../scripts/secretariat-inbox.js"></script>

<style>
  .secretariat { width: min(1600px, calc(100% - 48px)); margin: 0 auto; padding: clamp(48px, 7vw, 92px) 0 96px; }
  .secretariat__hero { max-width: 900px; margin: 0 auto 40px; }
  .secretariat h1 { margin: 14px 0; font-size: clamp(2.8rem, 7vw, 5.8rem); line-height: .98; letter-spacing: -.075em; }
  .secretariat__hero h1 span { color: var(--ember-ink); }
  .secretariat__hero > p { max-width: 640px; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.6; }
  .secretariat__panel { padding: clamp(20px, 3vw, 38px); border: 1px solid var(--line); border-radius: 20px; background: var(--paper); }
  .secretariat__panel--login { max-width: 920px; margin: 0 auto; }
  .secretariat__panel h2 { margin: 8px 0 0; font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -.05em; }
  .secretariat__login { display: grid; max-width: 580px; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 26px; }
  .secretariat__login label, .secretariat__filters label { display: grid; gap: 7px; color: var(--ink); font-weight: 650; }
  .secretariat__login input, .secretariat__filters input { width: 100%; min-width: 0; min-height: 44px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); font: inherit; font-weight: 400; }
  .secretariat__filters input::placeholder { color: #72757b; font-weight: 400; opacity: 1; }
  .secretariat__login button { grid-column: 1 / -1; justify-self: start; }
  .secretariat__heading, .secretariat__toolbar { display: flex; justify-content: space-between; align-items: center; gap: 18px; }
  .secretariat__heading h1 { margin: 8px 0 0; font-size: clamp(1.8rem, 4vw, 3rem); text-transform: none; }
  .secretariat__status { margin: 18px 0 0; color: var(--muted); }
  .secretariat__status[data-kind="error"] { color: #b42318; }
  .secretariat__status[data-kind="success"] { color: #247044; }
  .secretariat__records { margin-top: 24px; }
  .secretariat__tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 0; border-bottom: 1px solid var(--line); scrollbar-width: thin; }
  .secretariat__tabs button { flex: 0 0 auto; min-height: 44px; padding: 10px 15px; border: 1px solid transparent; border-bottom: 2px solid transparent; border-radius: 9px 9px 0 0; background: transparent; color: var(--muted); font: inherit; font-size: .9rem; font-weight: 700; white-space: nowrap; cursor: pointer; }
  .secretariat__tabs button[aria-selected="true"] { border-color: var(--line); border-bottom-color: var(--ember-ink); background: var(--paper); color: var(--ink); }
  .tab-label--short { display: none; }
  .secretariat__filters { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: 12px; margin: 20px 0 12px; }
  .secretariat__filters label { color: var(--muted); font-size: .88rem; }
  .secretariat__toolbar { margin-bottom: 14px; }
  .secretariat__select-all { display: inline-flex; align-items: center; gap: 9px; min-height: 42px; color: var(--muted); font-size: .9rem; font-weight: 550; cursor: pointer; }
  .secretariat__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 9px; }
  .secretariat__actions button { border: 1px solid transparent; }
  .secretariat__actions button:disabled { border-color: #d1d5db; background: #f3f4f6; color: #6b7280; cursor: not-allowed; opacity: 1; }
  .secretariat__table-wrap { max-width: 100%; overflow: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); overscroll-behavior-x: contain; }
  .secretariat table { width: max-content; min-width: 100%; border-collapse: separate; border-spacing: 0; table-layout: auto; text-align: left; }
  .secretariat :global(th), .secretariat :global(td) { min-width: 112px; max-width: 260px; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .secretariat :global(th) { position: sticky; top: 0; z-index: 1; background: #f8f8f7; color: var(--muted); font-size: .75rem; font-weight: 750; letter-spacing: .035em; text-transform: uppercase; }
  .secretariat :global(th:first-child), .secretariat :global(td:first-child) { position: sticky; left: 0; z-index: 2; width: 48px; min-width: 48px; max-width: 48px; background: var(--paper); }
  .secretariat :global(th:first-child) { z-index: 3; }
  .secretariat :global(td) { color: var(--ink); font-size: .88rem; line-height: 1.45; }
  .secretariat :global(td > span) { display: block; min-width: 0; }
  .secretariat :global(td:nth-child(2)) { font-weight: 700; }
  .secretariat :global(td:nth-child(4)) { overflow-wrap: anywhere; }
  .secretariat :global(td:last-child) { white-space: pre-wrap; }
  .secretariat tbody :global(tr:nth-child(even) td) { background: color-mix(in srgb, var(--surface) 65%, var(--paper)); }
  .secretariat tbody :global(tr:nth-child(even) td:first-child) { background: var(--surface); }
  .secretariat tbody :global(tr:hover td) { background: color-mix(in srgb, var(--ember) 7%, var(--paper)); }
  .secretariat tbody :global(tr:hover td:first-child) { background: color-mix(in srgb, var(--ember) 7%, var(--paper)); }
  .secretariat tbody :global(tr:last-child td) { border-bottom: 0; }
  .secretariat tbody :global(tr:has(td[colspan]) td) { position: static; padding: 24px; color: var(--muted); text-align: center; }
  .secretariat :global(input[type="checkbox"]) { width: 17px; height: 17px; accent-color: var(--ember-ink); }
  @media (max-width: 900px) {
    .secretariat { width: min(100% - 28px, 1440px); padding: 28px 0 56px; }
    .secretariat__login { grid-template-columns: 1fr; }
    .secretariat__login button { grid-column: auto; }
    .secretariat__heading { align-items: flex-start; flex-direction: row; gap: 10px; }
    .secretariat__heading > div { min-width: 0; }
    .secretariat__heading h1 { max-width: 16ch; font-size: clamp(1.65rem, 7vw, 2.25rem); line-height: 1.02; }
    .secretariat__heading > button { flex: 0 0 auto; min-height: 38px; padding: 8px 11px; font-size: .8rem; }
    .secretariat__filters { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
    .secretariat__filters label:first-child { grid-column: 1 / -1; }
    .secretariat__filters input { min-width: 0; width: 100%; font-size: .9rem; }
    .secretariat__tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; }
    .secretariat__tabs button { min-width: 0; padding-inline: 8px; text-align: center; white-space: normal; }
    .secretariat__toolbar { align-items: center; flex-wrap: wrap; }
    .secretariat__actions { justify-content: flex-end; }
    .secretariat__actions .button { min-width: 0; justify-content: center; padding-inline: 12px; font-size: .85rem; }
    .secretariat__table-wrap { overflow: visible; border: 0; background: transparent; }
    .secretariat table { display: block; width: 100%; max-width: 100%; min-width: 0; }
    .secretariat thead { display: none; }
    .secretariat tbody { display: grid; gap: 12px; }
    .secretariat tbody :global(tr) { display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: center; gap: 0 8px; min-width: 0; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); box-shadow: 0 3px 12px rgb(24 28 36 / 4%); }
    .secretariat tbody :global(tr:nth-child(even) td), .secretariat tbody :global(tr:hover td) { background: transparent; }
    .secretariat tbody :global(td), .secretariat tbody :global(td:first-child) { position: static; display: block; width: auto; min-width: 0; max-width: 100%; padding: 8px 0; border: 0; background: transparent; }
    .secretariat tbody :global(td:first-child) { grid-column: 1; grid-row: 1; align-self: center; }
    .secretariat tbody :global(td:first-child)::before { content: none; }
    .secretariat tbody :global(td:nth-child(2)) { grid-column: 2; grid-row: 1; padding-block: 8px 10px; font-size: 1rem; font-weight: 750; overflow-wrap: anywhere; }
    .secretariat tbody :global(td:nth-child(3)) { grid-column: 1 / -1; display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: start; gap: 10px; border-top: 1px solid var(--line); font-size: .875rem; color: var(--muted); }
    .secretariat tbody :global(td:nth-child(4)) { grid-column: 1 / -1; display: block; border-top: 1px solid var(--line); font-size: .875rem; color: var(--muted); }
    .secretariat tbody :global(td:nth-child(3) > span) { min-width: 0; overflow-wrap: anywhere; }
    .secretariat tbody :global(td:nth-child(4) > span) { display: block; max-width: 100%; overflow-x: auto; overflow-wrap: normal; white-space: nowrap; scrollbar-width: none; font-size: .84rem; }
    .secretariat tbody :global(td:nth-child(4) > span::-webkit-scrollbar) { display: none; }
    .secretariat tbody :global(td:nth-child(4)::before) { display: block; margin-bottom: 4px; }
    .secretariat tbody :global(td)::before { content: attr(data-label); color: var(--muted); font-size: .7rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
    .secretariat tbody :global(td[colspan]) { grid-column: 1 / -1; display: block; border: 0; text-align: center; }
    .secretariat tbody :global(td[colspan])::before { content: none; }
    .secretariat tbody :global(tr:has(td[colspan])) { display: block; }
  }
  @media (max-width: 640px) {
    .secretariat__tabs button { font-size: .8rem; }
    .tab-label--full { display: none; }
    .tab-label--short { display: inline; }
    .secretariat__toolbar { align-items: stretch; flex-direction: column; gap: 8px; }
    .secretariat__select-all { min-height: 38px; }
    .secretariat__actions, .secretariat__actions .button { width: 100%; }
    .secretariat__actions .button { justify-content: center; }
  }
  @media (max-width: 359px) {
    .secretariat__tabs button { padding-inline: 4px; font-size: .72rem; }
  }
</style>
