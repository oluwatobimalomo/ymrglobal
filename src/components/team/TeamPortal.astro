---
const { team, view, endpoint, apiKey } = Astro.props;
const isPrayer = team === 'prayer';
const isLogin = view === 'login';
const title = isPrayer ? 'Prayer request inbox' : 'Testimony submissions';
const pageTitle = isPrayer ? 'Prayer Team' : 'Testimony Team';
const description = isPrayer
  ? 'Sign in to review prayer requests and download records for follow-up.'
  : 'Sign in to review testimony submissions and download records for follow-up.';
const loginPath = `/team/${team === 'prayer' ? 'prayer' : 'testimonies'}`;
const inboxPath = `${loginPath}/inbox`;
const table = isPrayer ? 'prayer_requests' : 'testimony_submissions';
const fields = isPrayer
  ? 'id,created_at,name,email,prayer_focus,prayer_request'
  : 'id,created_at,name,category,testimony,status';
---

<main
  id="main"
  class="team-inbox"
  data-team-inbox
  data-view={view}
  data-team={team}
  data-endpoint={endpoint}
  data-api-key={apiKey}
  data-table={table}
  data-fields={fields}
  data-login-path={loginPath}
  data-inbox-path={inboxPath}
>
  {isLogin ? (
    <>
      <section class="team-inbox__hero">
        <span class="section-index">PRIVATE TEAM ACCESS</span>
        <h1>{isPrayer ? 'Prayer requests' : 'Testimonies'}<br /><span>for the {isPrayer ? 'prayer' : 'testimony'} team.</span></h1>
        <p>{description}</p>
      </section>
      <section class="team-inbox__panel team-inbox__panel--login" aria-labelledby="team-inbox-title">
        <div class="team-inbox__panel-heading">
          <div><span class="section-index">{pageTitle.toUpperCase()}</span><h2 id="team-inbox-title">Team sign in</h2></div>
        </div>
        <form class="team-inbox__login" data-login>
          <label>Email<input type="email" name="email" autocomplete="username" required /></label>
          <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
          <button class="button button--ember" type="submit">Sign in</button>
        </form>
        <p class="team-inbox__status" data-status role="status" aria-live="polite">Use your YMR team account to continue.</p>
      </section>
    </>
  ) : (
    <section class="team-inbox__panel team-inbox__panel--records" aria-labelledby="team-inbox-title">
      <div class="team-inbox__panel-heading">
        <div><span class="section-index">{pageTitle.toUpperCase()}</span><h1 id="team-inbox-title">{title}</h1></div>
        <button class="button button--outline" type="button" data-logout>Sign out</button>
      </div>
      <p class="team-inbox__status" data-status role="status" aria-live="polite">Checking your team access…</p>
      <div class="team-inbox__records" data-records hidden>
        {isPrayer ? (
          <div class="team-inbox__filters" aria-label="Filter prayer requests">
            <label>Search<input type="search" placeholder="Name, email, or words in the request" data-search /></label>
            <label>From<input type="date" data-date-from /></label>
            <label>To<input type="date" data-date-to /></label>
            <label>Prayer focus<select data-category><option value="">All prayer focuses</option><option>Family &amp; relationships</option><option>Health &amp; healing</option><option>Education</option><option>Work &amp; provision</option><option>Direction &amp; purpose</option><option>Faith &amp; spiritual growth</option><option>Other</option></select></label>
          </div>
        ) : (
          <div class="team-inbox__filters" aria-label="Filter testimonies">
            <label>Search<input type="search" placeholder="Name or words in the testimony" data-search /></label>
            <label>From<input type="date" data-date-from /></label>
            <label>To<input type="date" data-date-to /></label>
            <label>Category<select data-category><option value="">All categories</option><option>Healings</option><option>Academic Breakthroughs</option><option>Marital Settlement</option><option>Family &amp; Fruitfulness</option><option>Open Doors &amp; Provision</option><option>Deliverance &amp; Freedom</option><option>Business Breakthrough</option></select></label>
            <label>Status<select data-status-filter><option value="">All statuses</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option></select></label>
          </div>
        )}
        <div class="team-inbox__toolbar"><p data-count></p><div class="team-inbox__actions"><button class="button button--outline" type="button" data-download-selected>Download selected</button><button class="button button--ember" type="button" data-download>Download all matching</button></div></div>
        <div class="team-inbox__table-wrap"><table><thead><tr><th><input type="checkbox" aria-label={isPrayer ? 'Select all matching requests' : 'Select all matching testimonies'} data-select-all /></th><th>Received</th>{isPrayer ? <><th>Name</th><th>Email</th><th>Focus</th><th>Request</th></> : <><th>Name</th><th>Category</th><th>Status</th><th>Testimony</th></>}</tr></thead><tbody data-rows></tbody></table></div>
      </div>
    </section>
  )}
</main>

<script src="../../scripts/team-inbox.js"></script>

<style>
  .team-inbox { width: min(1280px, calc(100% - 48px)); margin: 0 auto; padding: clamp(54px, 8vw, 110px) 0 96px; }
  .team-inbox__hero { max-width: 850px; margin: 0 auto 48px; }
  .team-inbox h1 { margin: 16px 0; font-size: clamp(3rem, 8vw, 6.8rem); line-height: .96; letter-spacing: -.075em; }
  .team-inbox h1 span { color: var(--ember-ink); }
  .team-inbox__hero > p { max-width: 650px; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.6; }
  .team-inbox__panel { padding: clamp(20px, 4vw, 44px); border: 1px solid var(--line); border-radius: 22px; background: var(--surface); }
  .team-inbox__panel--login { max-width: 900px; margin: 0 auto; }
  .team-inbox__panel-heading, .team-inbox__toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .team-inbox__panel h2, .team-inbox__panel-heading h1 { margin: 8px 0 0; font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -.05em; }
  .team-inbox__login { display: grid; max-width: 520px; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 28px; }
  .team-inbox__login label { display: grid; gap: 8px; color: var(--ink); font-weight: 650; }
  .team-inbox__login input { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); font: inherit; }
  .team-inbox__login button { grid-column: 1 / -1; justify-self: start; }
  .team-inbox__status { margin: 18px 0 0; color: var(--muted); }
  .team-inbox__status[data-kind="error"] { color: #b42318; }
  .team-inbox__status[data-kind="success"] { color: #247044; }
  .team-inbox__records { margin-top: 28px; }
  .team-inbox__toolbar { margin-bottom: 16px; }
  .team-inbox__toolbar p { color: var(--muted); }
  .team-inbox__filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 14px; margin: 24px 0 18px; }
  .team-inbox__filters label { display: grid; gap: 7px; color: var(--muted); font-size: .9rem; font-weight: 650; }
  .team-inbox__filters input, .team-inbox__filters select { min-width: 0; min-height: 44px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); font: inherit; }
  .team-inbox__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .team-inbox input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--ember-ink); }
  .team-inbox__table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: 12px; }
  .team-inbox table { width: 100%; border-collapse: collapse; text-align: left; }
  .team-inbox th, .team-inbox td { min-width: 110px; padding: 13px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .team-inbox th { background: var(--paper); font-size: .8rem; }
  .team-inbox td:last-child { min-width: 280px; white-space: pre-wrap; }
  .team-inbox tbody tr:last-child td { border-bottom: 0; }
  @media (max-width: 620px) { .team-inbox { width: min(100% - 32px, 1280px); } .team-inbox__login, .team-inbox__filters { grid-template-columns: 1fr; } .team-inbox__login button { grid-column: auto; } .team-inbox__panel-heading, .team-inbox__toolbar { align-items: flex-start; flex-direction: column; } }
</style>
