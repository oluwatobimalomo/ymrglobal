---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode" aria-pressed="false">
  <span data-theme-moon><Icon name="moon" size={18} /></span>
  <span data-theme-sun hidden><Icon name="sun" size={18} /></span>
</button>

<script>
  const toggleTheme = (button) => {
    const dark = document.documentElement.dataset.theme === 'dark';
    const nextTheme = dark ? 'light' : 'dark';
    document.documentElement.classList.add('theme-switching');
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem('ymr-theme', nextTheme);
    } catch {}

    button.setAttribute('aria-label', `Switch to ${dark ? 'dark' : 'light'} mode`);
    button.setAttribute('title', `Switch to ${dark ? 'dark' : 'light'} mode`);
    button.setAttribute('aria-pressed', String(!dark));
    button.querySelector('[data-theme-moon]')?.toggleAttribute('hidden', !dark);
    button.querySelector('[data-theme-sun]')?.toggleAttribute('hidden', dark);
    const themeColor = document.querySelector('meta[name="theme-color"]');
    themeColor?.setAttribute('content', dark ? '#ffffff' : '#121416');

    void document.documentElement.offsetHeight;
    requestAnimationFrame(() => document.documentElement.classList.remove('theme-switching'));
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    button.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
    button.setAttribute('title', `Switch to ${dark ? 'light' : 'dark'} mode`);
    button.setAttribute('aria-pressed', String(dark));
    button.querySelector('[data-theme-moon]')?.toggleAttribute('hidden', dark);
    button.querySelector('[data-theme-sun]')?.toggleAttribute('hidden', !dark);
    button.addEventListener('click', () => toggleTheme(button));
  });
</script>
