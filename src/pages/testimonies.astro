---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';

const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || '').trim().replace(/\/$/, '');
const supabaseKey = (import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '').trim();

const categories = [
  'Healings',
  'Academic Breakthroughs',
  'Marital Settlement',
  'Family & Fruitfulness',
  'Open Doors & Provision',
  'Business Breakthrough',
];

const formatTestimonyCredit = (credit: string) => {
  const [rawName, ...details] = credit.split(' · ');
  const name = rawName?.trim() ?? '';
  const parts = name.split(/\s+/).filter(Boolean);
  const isPlaceholder = !name || /^anonymous$|^ymr testimony$/i.test(name);
  const isRoleAndInitial = /^(bro|sis)\s+[a-z]\.??$/i.test(name);
  const displayName = isPlaceholder || isRoleAndInitial
    ? 'Anonymous'
    : parts.length > 1
      ? `${parts[0]} ${parts.at(-1)?.replace(/[^\p{L}].*$/u, '').charAt(0)}.`
      : name;

  return [displayName, ...details].join(' · ');
};

