---

<SiteLayout title="Testimonies" description="Read testimonies of healing and answered prayer from previous YMR editions, and share your own story." current="testimonies">
  <main id="main" class="resource-page testimonies-page">
    <section class="resource-hero section-wrap" id="top" aria-labelledby="testimonies-title">
      <span class="section-index">YMR TESTIMONIES</span>
      <div class="resource-hero__row">
        <div><h1 id="testimonies-title">Lives changed.<br /><span>Be Inspired.</span></h1><p class="testimonies-page__scripture"><strong><em>For the testimony of Jesus is the spirit of prophecy</em></strong> - Rev. 19:10 <br> Read about the testimonies recorded during the previous editions of YMR to stir up your faith as you receive yours.</p></div>
        <a class="button button--ember" href="#send-testimony"><Icon name="sparkles" size={17} />Send your testimony</a>
      </div>
    </section>

    <section class="testimonies-archive section-wrap" id="stories" aria-labelledby="story-list-title">
      <div class="testimonies-filters" role="group" aria-label="Filter testimonies by category">
        <button type="button" data-category-filter="all" aria-pressed="true">All stories <span>{stories.length}</span></button>
        {categories.map((category) => <button type="button" data-category-filter={category} aria-pressed="false">{category} <span>{stories.filter((story) => story.category === category).length}</span></button>)}
      </div>
      <div class="testimonies-archive__grid" data-testimonies-grid>
        {stories.map((story) => (
          <article class="testimony-entry" data-testimony-entry data-category={story.category}>
            <button class="testimony-entry__open" type="button" data-story-open data-story-title={story.title} data-story-category={story.category} data-story-edition={story.edition} data-story-credit={formatTestimonyCredit(story.credit)} data-story-full={story.full} aria-haspopup="dialog" aria-label={`Read full ${story.edition} testimony: ${story.title}`}>
              <span class="testimony-entry__top"><span class="testimony-entry__icon"><Icon name={story.icon} size={20} /></span><span class="testimony-entry__meta"><span class="testimony-entry__category">{story.category}</span><span class="testimony-entry__year">{story.edition}</span></span></span>
              <span class="testimony-entry__copy"><strong>{story.title}</strong><span>{story.summary}</span></span>
              <span class="testimony-entry__credit">{formatTestimonyCredit(story.credit)}</span>
              <span class="testimony-entry__action">Read full testimony</span>
            </button>
          </article>
        ))}
      </div>
      <div class="testimonies-archive__empty" data-testimonies-empty hidden>
        <Icon name="book" size={22} /><a class="text-link" href="#send-testimony">Your testimony stirs up the faith of others</a>
      </div>
    </section>

    <section class="testimony-submit section-wrap" id="send-testimony" aria-labelledby="send-testimony-title">
      <div class="testimony-submit__intro"><span class="section-index">STRENGTHEN THE FAITH OF OTHERS</span><h2 id="send-testimony-title">Tell us what God has done.</h2><p>Testimonies are proofs of God's ability to answer prayers and pointers to what He will still do.</p></div>
      <form class="testimony-form" data-testimony-form data-endpoint={supabaseUrl ? `${supabaseUrl}/rest/v1/testimony_submissions` : ''} data-api-key={supabaseKey}>
        <div class="testimony-form__field"><label for="testimony-name">Your name</label><input id="testimony-name" name="name" autocomplete="name" maxlength="100" required /></div>
        <div class="testimony-form__field"><label for="testimony-category">Testimony category</label><select id="testimony-category" name="category" required><option value="" selected disabled>Choose a category</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></div>
        <div class="testimony-form__field testimony-form__field--full"><label for="testimony-story">Your testimony</label><textarea id="testimony-story" name="testimony" rows="7" minlength="20" maxlength="2500" required placeholder="What are you grateful for?"></textarea></div>
        <p class="form-privacy-note">Your identity remains anonymous. <a href="/privacy">Privacy Policy</a>.</p>
        <input type="hidden" name="_subject" value="New YMR testimony submission" />
        <label class="testimony-form__honeypot" aria-hidden="true">Leave this field empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        <div class="testimony-form__submit"><button class="button button--ember" type="submit"><Icon name="sparkles" size={17} />Send testimony</button><p data-testimony-status role="status" aria-live="polite"></p></div>
      </form>
    </section>

    <dialog class="story-modal" data-story-modal aria-labelledby="story-modal-title" aria-describedby="story-modal-body">
      <div class="story-modal__panel"><header class="story-modal__header"><div><span class="section-index" data-story-modal-category>YMR TESTIMONY</span><h2 id="story-modal-title" data-story-modal-title>Testimony</h2></div><button type="button" class="story-modal__close" data-story-close aria-label="Close testimony">×</button></header><p id="story-modal-body" data-story-modal-body></p><p class="story-modal__credit" data-story-modal-credit></p></div>
    </dialog>
  </main>

  <script>
    const filters = [...document.querySelectorAll('[data-category-filter]')];
    const entries = [...document.querySelectorAll('[data-testimony-entry]')];
    const emptyState = document.querySelector('[data-testimonies-empty]');
    const filterStories = (category) => {
      let visibleCount = 0;
      entries.forEach((entry) => {
        const show = category === 'all' || entry.getAttribute('data-category') === category;
        entry.toggleAttribute('hidden', !show);
        if (show) visibleCount += 1;
      });
      if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
    };
    filters.forEach((filter) => filter.addEventListener('click', () => {
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
      filterStories(filter.getAttribute('data-category-filter') || 'all');
    }));

    const storyModal = document.querySelector('[data-story-modal]');
    const modalTitle = storyModal?.querySelector('[data-story-modal-title]');
    const modalCategory = storyModal?.querySelector('[data-story-modal-category]');
    const modalBody = storyModal?.querySelector('[data-story-modal-body]');
    const modalCredit = storyModal?.querySelector('[data-story-modal-credit]');
    document.querySelectorAll('[data-story-open]').forEach((opener) => opener.addEventListener('click', () => {
      if (!(storyModal instanceof HTMLDialogElement)) return;
      if (modalTitle) modalTitle.textContent = opener.getAttribute('data-story-title') || 'YMR testimony';
      if (modalCategory) modalCategory.textContent = `${opener.getAttribute('data-story-edition') || 'YMR TESTIMONY'} · ${opener.getAttribute('data-story-category') || 'TESTIMONY'}`;
      if (modalBody) modalBody.textContent = opener.getAttribute('data-story-full') || '';
      if (modalCredit) modalCredit.textContent = opener.getAttribute('data-story-credit') || '';
      storyModal.showModal();
    }));
    storyModal?.querySelector('[data-story-close]')?.addEventListener('click', () => {
      if (storyModal instanceof HTMLDialogElement) storyModal.close();
    });
    storyModal?.addEventListener('click', (event) => {
      if (event.target === storyModal && storyModal instanceof HTMLDialogElement) storyModal.close();
    });

    const testimonyForm = document.querySelector('[data-testimony-form]');
    const formStatus = testimonyForm?.querySelector('[data-testimony-status]');
    testimonyForm?.addEventListener('submit', async (event) => {
      if (!(testimonyForm instanceof HTMLFormElement)) return;
      event.preventDefault();
      const data = new FormData(testimonyForm);
      if (String(data.get('_gotcha') || '').trim()) return;
      const endpoint = testimonyForm.getAttribute('data-endpoint') || '';
      const apiKey = testimonyForm.getAttribute('data-api-key') || '';
      const submitButton = testimonyForm.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (!endpoint || !apiKey) {
        if (formStatus) formStatus.textContent = 'Online submissions are being set up. Please try again later.';
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        return;
      }

      if (formStatus) formStatus.textContent = 'Sending your testimony…';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({
            name: String(data.get('name') || '').trim(),
            category: String(data.get('category') || ''),
            testimony: String(data.get('testimony') || '').trim(),
          }),
        });
        if (!response.ok) throw new Error('Submission failed');
        testimonyForm.reset();
        if (formStatus) formStatus.textContent = 'Thank you. Your testimony has been recorded.';
      } catch {
        if (formStatus) formStatus.textContent = 'We could not send that right now. Please try again later.';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });
  </script>
</SiteLayout>
