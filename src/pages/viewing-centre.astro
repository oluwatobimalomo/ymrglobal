---
import SiteLayout from '../layouts/SiteLayout.astro';
const endpoint = `${(import.meta.env.PUBLIC_SUPABASE_URL || '').trim().replace(/\/$/, '')}/rest/v1/viewing_centre_interests`;
const apiKey = (import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '').trim();
const zones = ['North Central', 'North East', 'North West', 'South East', 'South South', 'South West'];
---

<SiteLayout title="Host a YMR Viewing Centre" description="Bring YMR 2026 to your city. Register your interest in hosting a watch party where YMR sessions will be streamed around the world." current="viewing-centre">
  <main id="main" class="viewing-page">
    <section class="viewing-hero">
      <div class="viewing-hero__copy"><span class="section-index">CITY TAKERS · YMR GLOBAL 2026</span><h1>Bring <br /><span>YMR 2026 to your City.</span></h1><p>Host a viewing centre and gather your city to watch YMR sessions together, wherever you are in the world.</p><div class="viewing-hero__meta"><span>YMR Viewing Centres</span><span>One global gathering</span></div></div>
      <figure class="viewing-hero__poster"><img src="/images/blog/city-takers-viewing-centres.jpg" alt="YMR 10 years: City Takers, YMR Global Revival 2026. Host a viewing centre in your nation." width="1272" height="1800" loading="eager" /><figcaption>One gathering. Every nation.</figcaption></figure>
    </section>
    <section class="viewing-form-section" aria-labelledby="viewing-form-title">
      <div class="viewing-form-intro"><span class="section-index">HOST INTEREST</span><h2 id="viewing-form-title">Let’s start with you.</h2><p>A few details will help our team connect with you and learn where you hope to host.</p><p class="viewing-privacy">We’ll use these details to follow up about hosting. Read our <a href="/privacy">Privacy Policy</a>.</p></div>
      <form class="viewing-form" data-viewing-form data-endpoint={endpoint} data-api-key={apiKey} novalidate>
        <div class="viewing-progress"><div class="viewing-progress__top"><span data-step-label>Step 1 of 6</span><span data-step-name>Host name</span></div><div class="viewing-progress__track" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1"><span data-progress-fill></span></div></div>
        <div class="viewing-question" data-question="host_name"><label for="host-name">What should we call you?</label><p>Your name as the host or primary contact.</p><input id="host-name" name="host_name" autocomplete="name" maxlength="120" required placeholder="Your full name" /><span class="viewing-error" data-error></span></div>
        <div class="viewing-question" data-question="contact"><label for="host-contact">What’s the best number to reach you?</label><p>Choose a country code, then enter your phone number.</p><input id="host-contact" name="contact" type="tel" autocomplete="tel" required placeholder="Phone number" /><span class="viewing-error" data-error></span></div>
        <div class="viewing-question" data-question="email"><label for="host-email">What’s your email address?</label><p>We’ll use this to follow up about your viewing centre.</p><input id="host-email" name="email" type="email" autocomplete="email" maxlength="200" required placeholder="you@example.com" /><span class="viewing-error" data-error></span></div>
        <div class="viewing-question" data-question="location_scope"><fieldset><legend>Where will you host?</legend><p>Choose the location that best describes your viewing centre.</p><div class="viewing-choice-grid"><label class="viewing-choice"><input type="radio" name="location_scope" value="International" required /><span><strong>Outside Nigeria</strong><small>International host</small></span><b aria-hidden="true">→</b></label><label class="viewing-choice"><input type="radio" name="location_scope" value="Within Nigeria" required /><span><strong>Within Nigeria</strong><small>Host in Nigeria</small></span><b aria-hidden="true">→</b></label></div></fieldset><span class="viewing-error" data-error></span></div>
        <div class="viewing-question" data-question="region">
          <div class="country-picker" data-country-picker data-region-international hidden><label for="country-search">Which country?</label><p>Select the country where you plan to host.</p><div class="country-picker__control"><span class="country-picker__flag" data-country-flag aria-hidden="true">🌍</span><input id="country-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="country-options" autocomplete="off" placeholder="Search countries" data-country-search /><input id="host-country" name="country" type="hidden" required /><div class="country-picker__options" id="country-options" role="listbox" aria-label="Countries" data-country-options hidden></div></div><span class="country-picker__status" data-country-status aria-live="polite"></span></div>
          <div data-region-nigeria hidden><label for="host-zone">Which geopolitical zone?</label><p>Select the zone where you plan to host.</p><select id="host-zone" name="geopolitical_zone"><option value="">Choose a zone</option>{zones.map((zone) => <option value={zone}>{zone}</option>)}</select></div><span class="viewing-error" data-error></span>
        </div>
        <div class="viewing-question" data-question="exact_address"><label for="host-address">What is the exact address?</label><p>Share a venue address or a clear location people can use to find you.</p><textarea id="host-address" name="exact_address" rows="3" maxlength="500" required placeholder="Venue, street, city, and any helpful directions"></textarea><span class="viewing-error" data-error></span></div>
        <div class="viewing-form__actions"><button class="button button--outline" type="button" data-previous hidden>Back</button><button class="button button--ember" type="button" data-next>Continue</button></div>
        <p class="viewing-form__status" data-status role="status" aria-live="polite"></p>
        <div class="viewing-thanks" data-thanks hidden><img class="viewing-thanks__anniversary" src="/images/brand/ymr-at-10-logo-light.webp" alt="YMR celebrating ten years" width="520" height="520" /><div class="viewing-thanks__copy"><span class="viewing-thanks__check" aria-hidden="true">✓</span><span class="section-index">THANK YOU</span><h3>Your city could be next.</h3><p>Thank you for indicating interest to host a watch party for YMR 2026. Our team will be in touch with you shortly.</p></div></div>
      </form>
    </section>
  </main>
</SiteLayout>
<script>
  import intlTelInput from 'intl-tel-input';
  import countries from 'intl-tel-input/data';
  import 'intl-tel-input/styles';
  const form = document.querySelector('[data-viewing-form]');
  if (form instanceof HTMLFormElement) {
    const questions = [...form.querySelectorAll('[data-question]')];
    const next = form.querySelector('[data-next]');
    const previous = form.querySelector('[data-previous]');
    const fill = form.querySelector('[data-progress-fill]');
    const progress = form.querySelector('[role="progressbar"]');
    const stepLabel = form.querySelector('[data-step-label]');
    const stepName = form.querySelector('[data-step-name]');
    const status = form.querySelector('[data-status]');
    const names = ['Host name', 'Contact', 'Email', 'Location', 'Region', 'Exact address'];
    const phoneInput = form.querySelector('#host-contact');
    const phonePicker = phoneInput ? intlTelInput(phoneInput, { initialCountry: 'ng', countryOrder: ['ng', 'gb', 'us'], separateDialCode: true, countrySearch: true, loadUtils: () => import('intl-tel-input/utils') }) : null;
    const countrySearch = form.querySelector('[data-country-search]');
    const countryValue = form.querySelector('#host-country');
    const countryFlag = form.querySelector('[data-country-flag]');
    const countryOptions = form.querySelector('[data-country-options]');
    const countryStatus = form.querySelector('[data-country-status]');
    const countryError = form.querySelector('[data-question="region"] [data-error]');
    const countryNames = new Intl.DisplayNames(['en'], { type: 'region' });
    const countryList = countries.filter(({ iso2 }) => iso2 !== 'ng').map((country) => ({ ...country, name: countryNames.of(country.iso2.toUpperCase()) || country.iso2.toUpperCase(), flag: [...country.iso2.toUpperCase()].map((character) => String.fromCodePoint(127397 + character.charCodeAt(0))).join('') })).sort((a, b) => a.name.localeCompare(b.name));
    const closeCountries = () => { countryOptions.hidden = true; countrySearch.setAttribute('aria-expanded', 'false'); };
    const chooseCountry = (country) => {
      countryValue.value = country.name;
      countrySearch.value = country.name;
      countryFlag.textContent = country.flag;
      countrySearch.setAttribute('aria-expanded', 'false');
      countryOptions.hidden = true;
      countryStatus.textContent = '';
      countryError.textContent = '';
    };
    const renderCountries = (query = '') => {
      const normalizedQuery = query.trim().toLocaleLowerCase();
      const matches = countryList.filter(({ name }) => name.toLocaleLowerCase().includes(normalizedQuery)).slice(0, 10);
      countryOptions.replaceChildren();
      matches.forEach((country) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'country-picker__option';
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', String(countryValue.value === country.name));
        const flag = document.createElement('span');
        flag.className = 'country-picker__option-flag';
        flag.setAttribute('aria-hidden', 'true');
        flag.textContent = country.flag;
        const name = document.createElement('span');
        name.className = 'country-picker__option-name';
        name.textContent = country.name;
        option.append(flag, name);
        option.addEventListener('mousedown', (event) => event.preventDefault());
        option.addEventListener('click', () => chooseCountry(country));
        countryOptions.append(option);
      });
      countryStatus.textContent = matches.length ? '' : 'No countries match that search.';
      countryOptions.hidden = false;
      countrySearch.setAttribute('aria-expanded', 'true');
    };
    countrySearch.addEventListener('focus', () => renderCountries(countrySearch.value === countryValue.value ? '' : countrySearch.value));
    countrySearch.addEventListener('input', () => { countryValue.value = ''; countryFlag.textContent = '🌍'; countryStatus.textContent = ''; renderCountries(countrySearch.value); countryError.textContent = ''; });
    countrySearch.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { closeCountries(); return; }
      if (event.key === 'ArrowDown') { event.preventDefault(); countryOptions.querySelector('button')?.focus(); }
    });
    countryOptions.addEventListener('keydown', (event) => {
      const options = [...countryOptions.querySelectorAll('button')];
      const current = options.indexOf(document.activeElement);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); options[Math.max(0, Math.min(options.length - 1, current + (event.key === 'ArrowDown' ? 1 : -1)))]?.focus(); }
      if (event.key === 'Escape') { closeCountries(); countrySearch.focus(); }
      if (event.key === 'Tab') closeCountries();
    });
    document.addEventListener('click', (event) => { if (!event.target.closest('[data-country-picker]')) closeCountries(); });
    let index = 0;
    const update = (focus = false) => {
      questions.forEach((question, i) => question.hidden = i !== index);
      previous.hidden = index === 0;
      const finalStep = index === questions.length - 1;
      next.type = finalStep ? 'submit' : 'button';
      next.textContent = finalStep ? 'Send interest' : 'Continue';
      stepLabel.textContent = `Step ${index + 1} of ${questions.length}`;
      stepName.textContent = names[index];
      fill.style.width = `${((index + 1) / questions.length) * 100}%`;
      progress.setAttribute('aria-valuenow', String(index + 1));
      if (focus) questions[index].querySelector('input:not([type=radio]):not([type=hidden]), select, textarea')?.focus();
    };
    const isValid = () => {
      const question = questions[index];
      const error = question.querySelector('[data-error]');
      error.textContent = '';
      if (index === 3 && !form.querySelector('input[name="location_scope"]:checked')) {
        error.textContent = 'Choose one location to continue.';
        return false;
      }
      if (index === 4) {
        const selected = form.querySelector('input[name="location_scope"]:checked')?.value;
        const field = selected === 'International' ? countryValue : form.elements.geopolitical_zone;
        if (!field.value) { error.textContent = 'Choose an option to continue.'; (selected === 'International' ? countrySearch : field).focus(); return false; }
        return true;
      }
      const field = question.querySelector('input:not([type=radio]):not([type=hidden]), textarea');
      if (field && !field.checkValidity()) { field.reportValidity(); return false; }
      return true;
    };
    next.addEventListener('click', (event) => { if (index === questions.length - 1) return; event.preventDefault(); if (isValid()) { index++; update(true); } });
    previous.addEventListener('click', () => { if (index > 0) { index--; update(true); } });
    form.querySelectorAll('input[name="location_scope"]').forEach((radio) => radio.addEventListener('change', () => {
      const international = radio.value === 'International' && radio.checked;
      form.querySelector('[data-region-international]').hidden = !international;
      form.querySelector('[data-region-nigeria]').hidden = international || !form.querySelector('input[name="location_scope"][value="Within Nigeria"]:checked');
      countryValue.required = international;
      form.elements.geopolitical_zone.required = !international;
      form.querySelector('[data-question="location_scope"] [data-error]').textContent = '';
      countryError.textContent = '';
      if (index === 3) { index = 4; update(true); }
    }));
    form.elements.geopolitical_zone.addEventListener('change', () => { countryError.textContent = ''; });
    form.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !(event.target instanceof HTMLTextAreaElement) && index < questions.length - 1 && event.target?.type !== 'radio') { event.preventDefault(); next.click(); }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (index !== questions.length - 1 || !isValid()) return;
      const endpoint = form.dataset.endpoint;
      const apiKey = form.dataset.apiKey;
      if (!endpoint || !apiKey) { status.textContent = 'This form is temporarily unavailable. Please contact info@ymrglobal.org.'; return; }
      next.disabled = true; status.textContent = 'Sending your interest…';
      const data = new FormData(form);
      const locationScope = String(data.get('location_scope'));
      const payload = { host_name: String(data.get('host_name')).trim(), contact: phonePicker?.getNumber() || String(data.get('contact')).trim(), email: String(data.get('email')).trim(), location_scope: locationScope, country: locationScope === 'International' ? String(data.get('country')) : null, geopolitical_zone: locationScope === 'Within Nigeria' ? String(data.get('geopolitical_zone')) : null, exact_address: String(data.get('exact_address')).trim() };
      try {
        const response = await fetch(endpoint, { method: 'POST', headers: { apikey: apiKey, 'Content-Type': 'application/json', Prefer: 'return=minimal' }, body: JSON.stringify(payload) });
        if (!response.ok) throw new Error('We couldn’t send your details just now. Please try again.');
        form.dataset.submitted = 'true';
        form.querySelector('.viewing-progress').hidden = true;
        questions.forEach((question) => question.hidden = true);
        form.querySelector('.viewing-form__actions').hidden = true;
        form.querySelector('[data-thanks]').hidden = false;
        status.textContent = '';
        status.setAttribute('aria-label', 'Your host interest was sent.');
      } catch (error) { status.textContent = error instanceof Error ? error.message : 'We couldn’t send your details just now. Please try again.'; next.disabled = false; }
    });
    update();
  }
</script>

<style>
  .viewing-page{--viewing-max:1180px;color:var(--ink)}.viewing-hero{display:grid;width:min(calc(100% - var(--page-gutter) - var(--page-gutter)),var(--viewing-max));grid-template-columns:minmax(0,1fr) minmax(220px,.62fr);align-items:center;gap:clamp(36px,8vw,110px);margin:0 auto;padding:clamp(46px,8vw,104px) 0 80px}.viewing-hero__copy{max-width:680px}.viewing-hero h1{margin:18px 0 20px;font:650 clamp(3.5rem,8.5vw,7.7rem)/.88 var(--display);letter-spacing:-.085em}.viewing-hero h1 span{color:var(--ember-ink)}.viewing-hero__copy>p{max-width:580px;color:var(--muted);font-size:clamp(1.05rem,1.7vw,1.35rem);line-height:1.6}.viewing-hero__meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:28px;color:var(--muted);font-size:.82rem;font-weight:650}.viewing-hero__meta span+span{padding-inline-start:22px;border-inline-start:1px solid var(--line)}.viewing-hero__poster{margin:0;padding:12px;border:1px solid var(--line);border-radius:22px;background:var(--surface);transform:rotate(1.3deg)}.viewing-hero__poster img{display:block;width:100%;height:auto;aspect-ratio: .707;object-fit:cover;border-radius:14px}.viewing-hero__poster figcaption{padding:12px 5px 2px;color:var(--muted);font-size:.7rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.viewing-form-section{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.1fr);gap:clamp(34px,8vw,120px);width:min(calc(100% - var(--page-gutter) - var(--page-gutter)),1040px);margin:0 auto;padding:72px 0 120px;border-top:1px solid var(--line)}.viewing-form-intro{position:sticky;top:110px;align-self:start}.viewing-form-intro h2{margin:14px 0;font:620 clamp(2.2rem,4.3vw,3.7rem)/.98 var(--display);letter-spacing:-.065em}.viewing-form-intro p{max-width:330px;color:var(--muted);line-height:1.6}.viewing-form{min-width:0;padding:clamp(22px,4vw,44px);border:1px solid var(--line);border-radius:20px;background:var(--paper);box-shadow:0 16px 48px rgb(26 24 22 / 6%)}.viewing-progress{margin-bottom:34px}.viewing-progress__top{display:flex;justify-content:space-between;gap:16px;color:var(--muted);font-size:.8rem}.viewing-progress__top span:last-child{color:var(--ink);font-weight:700}.viewing-progress__track{height:4px;margin-top:12px;overflow:hidden;border-radius:99px;background:var(--surface)}.viewing-progress__track span{display:block;width:16.6%;height:100%;border-radius:inherit;background:var(--ember);transition:width .25s ease}.viewing-question{min-height:0}.viewing-question[hidden]{display:none}.viewing-question label,.viewing-question legend{display:block;margin:0;color:var(--ink);font:620 clamp(1.35rem,2.8vw,2rem)/1.18 var(--display);letter-spacing:-.035em}.viewing-question fieldset{padding:0;border:0}.viewing-question p{margin:10px 0 22px;color:var(--muted);font-size:.95rem;line-height:1.55}.viewing-question input:not([type=radio]):not([type=hidden]),.viewing-question select,.viewing-question textarea{display:block;width:100%;min-height:50px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink);font-family:inherit;font-size:1rem;font-weight:400;line-height:1.4}.viewing-question textarea{min-height:92px;resize:vertical}.viewing-question input::placeholder,.viewing-question textarea::placeholder{color:#85817b;font-weight:400}.viewing-question input:focus-visible,.viewing-question select:focus-visible,.viewing-question textarea:focus-visible{outline:3px solid color-mix(in srgb,var(--ember) 36%,transparent);outline-offset:2px;border-color:var(--ember-ink)}.viewing-choice-grid{display:grid;gap:10px}.viewing-choice{display:flex!important;min-height:68px;align-items:center;gap:14px;padding:14px 16px!important;border:1px solid var(--line);border-radius:11px;cursor:pointer;transition:border-color .15s,background-color .15s}.viewing-choice:has(input:checked){border-color:var(--ember);background:color-mix(in srgb,var(--ember) 7%,var(--paper))}.viewing-choice input{width:18px;height:18px;accent-color:var(--ember-ink)}.viewing-choice span{display:grid;gap:4px;flex:1}.viewing-choice strong{font-size:.95rem;letter-spacing:0}.viewing-choice small{color:var(--muted);font-size:.8rem}.viewing-choice b{color:var(--ember-ink);font-size:1.2rem}.viewing-error{display:block;min-height:20px;margin-top:8px;color:#b42318;font-size:.85rem}.viewing-form__actions{display:flex;align-items:center;gap:12px;margin-top:16px}.viewing-form__actions[hidden]{display:none!important}.viewing-progress[hidden],.viewing-thanks[hidden],.viewing-question[hidden]{display:none!important}.viewing-privacy a{color:var(--ember-ink);font-weight:650;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}.viewing-form__hint{display:none}.viewing-form__status{min-height:20px;color:#b42318;font-size:.86rem}.viewing-thanks{padding:26px 0 12px}.viewing-thanks[hidden]{display:none}.viewing-thanks__check{display:grid;width:48px;height:48px;place-items:center;margin-bottom:20px;border-radius:50%;background:color-mix(in srgb,var(--ember) 18%,var(--paper));color:var(--ember-ink);font-size:1.4rem}.viewing-thanks h3{margin:10px 0;font:620 2.3rem/1 var(--display);letter-spacing:-.06em}.viewing-thanks p{color:var(--muted);line-height:1.65}@media(max-width:760px){.viewing-hero{grid-template-columns:minmax(0,1fr) minmax(120px,.48fr);gap:20px;padding-top:48px;padding-bottom:56px}.viewing-hero h1{font-size:clamp(2.8rem,10vw,5rem)}.viewing-hero__meta{gap:10px}.viewing-hero__meta span+span{padding-inline-start:10px}.viewing-form-section{grid-template-columns:1fr;gap:22px;padding:48px 0 72px}.viewing-form-intro{position:static}.viewing-form-intro h2{font-size:2.5rem}.viewing-form-intro p{margin-bottom:0}.viewing-question{min-height:0}}@media(max-width:480px){.viewing-hero{grid-template-columns:1fr;align-items:start}.viewing-hero__copy{max-width:100%}.viewing-hero__poster{width:min(65%,230px);justify-self:end;margin-top:-2px}.viewing-form{padding:20px 16px}.viewing-question{min-height:0}.viewing-question label,.viewing-question legend{font-size:1.4rem}.viewing-form__hint{display:none}.viewing-form__actions{justify-content:space-between}.viewing-form__actions .button{flex:1}}
</style>
<style is:global>
  .viewing-form__actions button[hidden]{display:none!important}
  .viewing-question input:not([type=radio]):not([type=hidden]){display:block}
  .iti{display:block;width:100%;min-width:0}
  .iti input[type=tel]{box-sizing:border-box;width:100%;min-width:0;min-height:50px}
  .iti__country-container{height:100%}
  .iti__selected-country{padding-inline:12px}
  .iti__selected-country-primary{height:100%;gap:7px}
  .iti__dropdown-content{z-index:30;border:1px solid var(--line);border-radius:10px;box-shadow:0 14px 34px rgba(25,22,19,.14)}
  .iti__search-input{font:inherit}
  .country-picker__control{position:relative}
  #country-search{padding-inline-start:64px}
  .country-picker__flag{position:absolute;z-index:1;top:50%;left:15px;translate:0 -50%;font-size:1.25rem;pointer-events:none}
  .country-picker__options{position:absolute;z-index:20;inset:calc(100% + 6px) 0 auto;max-height:270px;overflow:auto;padding:5px;border:1px solid var(--line);border-radius:11px;background:var(--paper);box-shadow:0 14px 34px rgba(25,22,19,.14)}
  .country-picker__options[hidden]{display:none!important}
  .country-picker__option{display:flex;width:100%;min-height:42px;align-items:center;gap:10px;padding:8px 11px;border:0;border-radius:7px;background:transparent;color:var(--ink);font-family:inherit;font-size:.92rem;font-weight:500;line-height:1.3;text-align:left;cursor:pointer}
  .country-picker__option-flag{flex:0 0 1.35rem;font-size:1rem;line-height:1}
  .country-picker__option-name{display:block;color:var(--ink);opacity:1;visibility:visible}
  .country-picker__option:hover,.country-picker__option:focus-visible{outline:none;background:color-mix(in srgb,var(--ember) 11%,var(--paper));color:var(--ember-ink)}
  .country-picker__status{display:block;min-height:0;margin-top:7px;color:var(--muted);font-size:.75rem}
  .viewing-error{color:var(--ember-ink)}
  .viewing-form[data-submitted=true]{align-self:start}
  .viewing-form[data-submitted=true]{padding-block:22px}
  .viewing-form[data-submitted=true] .viewing-form__status{display:none}
  .viewing-thanks{display:grid;grid-template-columns:minmax(0,1fr) minmax(130px,.38fr);grid-template-areas:"copy emblem";align-items:start;gap:20px;padding:0}
  .viewing-thanks__copy{grid-area:copy;max-width:600px}
  .viewing-thanks__anniversary{grid-area:emblem;display:block;width:min(100%,190px);height:auto;justify-self:end}
  .viewing-thanks__check{width:42px;height:42px;margin:0 0 16px}
