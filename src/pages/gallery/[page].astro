---
import GalleryArchive from '../../components/GalleryArchive.astro';
import { galleryPhotos } from '../../data/gallery';

export function getStaticPaths() {
  return Array.from({ length: Math.ceil(galleryPhotos.length / 12) - 1 }, (_, index) => ({ params: { page: String(index + 2) }, props: { page: index + 2 } }));
}

const { page } = Astro.props;
---

<GalleryArchive page={page} />
