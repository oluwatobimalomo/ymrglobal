---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';

const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || '').trim().replace(/\/$/, '');
const supabaseKey = (import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '').trim();
const delegatesEndpoint = supabaseUrl ? `${supabaseUrl}/rest/v1/delegate_registrations` : '';
---

<SiteLayout
  title="Delegates"
  description="Plan your trip to YMR 2026 with visa invitation support, scheduled airport pick-up, arrival guidance, discounted accommodation information, and delegate contacts."
  current="delegates"
>
  <main id="main" class="resource-page delegate-page">
    <section class="delegate-hero section-wrap" id="top" aria-labelledby="delegate-title">
      <div class="delegate-hero__copy">
        <span class="section-index"><Icon name="globe" size={15} /> YMR GLOBAL · INTERNATIONAL DELEGATES</span>
        <h1 id="delegate-title">Travel well.<br /><span>Arrive welcomed.</span></h1>
        <p>Travelling to YMR from another nation? <br>Notify us of your travel plans so our Foreign Delegates team can prepare for your arrival.</p>
        <button class="button button--ember" type="button" data-open-delegate-registration aria-controls="delegate-registration-panel" aria-expanded="false"><Icon name="plane" size={18} />Register as a delegate</button>
      </div>
      <div class="delegate-journey" aria-label="Personalized support for your journey to YMR">
        <img class="delegate-journey__watermark delegate-journey__watermark--light" src="/images/brand/ymr-at-10-logo-light.webp" alt="" aria-hidden="true" />
        <img class="delegate-journey__watermark delegate-journey__watermark--dark" src="/images/brand/ymr-at-10-logo.webp" alt="" aria-hidden="true" />
        <div class="delegate-journey__top"><span>YOUR YMR JOURNEY</span><span>26—30 DEC 2026</span></div>
        <div class="delegate-journey__route" aria-hidden="true"><span class="delegate-journey__point"><Icon name="plane" size={20} /></span><i></i><span class="delegate-journey__point delegate-journey__point--arrival"><Icon name="mapPin" size={20} /></span><i></i><span class="delegate-journey__point delegate-journey__point--stay"><Icon name="bed" size={20} /></span><i></i><span class="delegate-journey__point delegate-journey__point--return"><Icon name="plane" size={20} /></span></div>
        <div class="delegate-journey__labels"><span>Travel to Nigeria</span><span>Arrive in Nigeria</span><span>Stay &amp; YMR experience</span><span>Return to your destination</span></div>
        <div class="delegate-journey__welcome"><span class="delegate-journey__globe"><Icon name="globe" size={25} /></span><span><strong>Guidance throughout your YMR journey.</strong><small>Our team can help you plan your arrival, stay, and return journey.</small></span><Icon name="sparkles" size={18} /></div>
        <div class="delegate-journey__footer"><span>YMR GLOBAL</span><span>...raising a burning generation</span></div>
      </div>
    </section>

    <section class="delegate-info section-wrap" id="before-you-travel" aria-labelledby="delegate-before-title">
      <header class="delegate-info__heading">
        <span class="section-index">BEFORE YOU TRAVEL · PLEASE TAKE NOTE</span>
        <h2 id="delegate-before-title">A few things to plan before you go.</h2>
        <p>These details will help you prepare for your journey and make arrival at Redemption City straightforward.</p>
      </header>
      <div class="delegate-info__grid">
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="book" size={20} /></span>
          <div><span class="delegate-info__step">01 · VISA SUPPORT</span><h3>Need a visa?</h3><p>Contact the Foreign Delegates Management Team as soon as possible if you need a visa. The team will provide you with a letter of invitation promptly to support your application.</p></div>
        </article>
        <article class="delegate-info__card delegate-info__card--pickup">
          <span class="delegate-info__icon"><Icon name="plane" size={20} /></span>
          <div><span class="delegate-info__step">02 · AIRPORT PICK-UP</span><h3>One scheduled pick-up</h3><p>All delegates will be collected from the airport at one set time. Please plan your itinerary around it.</p><strong class="delegate-info__time"><Icon name="calendar" size={15} />12:00 noon · Saturday, 26 December 2026</strong></div>
        </article>
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="car" size={20} /></span>
          <div><span class="delegate-info__step">03 · ARRIVING EARLY?</span><h3>Ask about transport</h3><p>If you arrive before 26 December, the team can recommend professional airport transport to Redemption City at discounted rates.</p></div>
        </article>
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="mapPin" size={20} /></span>
          <div><span class="delegate-info__step">04 · ON ARRIVAL</span><h3>Visit the Information Desk</h3><p>When you arrive at the retreat, go to the Information Desk to register and collect your delegate tag.</p></div>
        </article>
      </div>
    </section>

    <section class="delegate-info delegate-info--stay section-wrap" aria-labelledby="delegate-stay-title">
      <header class="delegate-info__heading">
        <span class="section-index">YOUR STAY WITH US</span>
        <h2 id="delegate-stay-title">During the retreat.</h2>
      </header>
      <div class="delegate-info__grid delegate-info__grid--three">
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="bed" size={20} /></span>
          <div><span class="delegate-info__step">ACCOMMODATION</span><h3>Discounted delegate rates</h3><p>Paid accommodation details and a booking link will be shared with you. The team can help if you have questions or difficulty booking.</p></div>
        </article>
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="heart" size={20} /></span>
          <div><span class="delegate-info__step">A SPECIAL TIME OF PRAYER</span><h3>Plan to attend every session</h3><p>Pastor Daniel Olawande will call out the foreign delegates to pray for them during the retreat. Be present for every session so you don’t miss this moment.</p></div>
        </article>
        <article class="delegate-info__card">
          <span class="delegate-info__icon"><Icon name="sparkles" size={20} /></span>
          <div><span class="delegate-info__step">OFFICIAL MERCHANDISE</span><h3>Place your order</h3><p>YMR merchandise such as tops, caps, books among others are available for sale. Message Fiyin or Timileyin to get yours.</p></div>
        </article>
      </div>
    </section>

    <section class="delegate-contact section-wrap" id="delegate-contacts" aria-labelledby="delegate-contact-title">
      <div class="delegate-contact__intro"><span class="section-index">DELEGATE OFFICERS · CALL/WHATSAPP</span><h2 id="delegate-contact-title">Questions? Reach Fiyin or Timileyin.</h2><p>They are available round-the-clock to attend to your needs.</p></div>
      <div class="delegate-contact__links">
        <a href="https://wa.me/447881155846" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /><span><small>WHATSAPP</small><strong>+44 7881 155 846</strong></span></a>
        <a href="https://wa.me/2348178213695" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /><span><small>WHATSAPP</small><strong>+234 817 821 3695</strong></span></a>
      </div>
    </section>

  </main>

  <dialog class="registration-form-panel" id="delegate-registration-panel" data-delegate-panel aria-labelledby="delegate-registration-title" aria-describedby="delegate-registration-description">
    <div class="registration-form-panel__heading">
      <div><span class="section-index">YMR GLOBAL · INTERNATIONAL DELEGATES</span><h2 id="delegate-registration-title">Delegate registration</h2></div>
      <button class="registration-close" type="button" data-delegate-close aria-label="Close delegate registration form">×</button>
    </div>
    <p class="registration-form-panel__description" id="delegate-registration-description">Share your travel and accommodation plans so our Foreign Delegates team can help you prepare for YMR 2026.</p>
    <form class="ymr-registration-form" data-delegate-form data-endpoint={delegatesEndpoint} data-api-key={supabaseKey}>
      <div class="registration-fields registration-fields--delegate">
        <div class="registration-field"><label for="delegate-name">Full name <span>*</span></label><input id="delegate-name" name="full_name" autocomplete="name" required maxlength="120" /></div>
        <div class="registration-field"><label for="delegate-email">Email address <span>*</span></label><input id="delegate-email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
        <div class="registration-field"><label for="delegate-phone">Phone number <span>*</span></label><div class="registration-phone-row"><input id="delegate-phone" name="phone_number" data-delegate-phone type="tel" autocomplete="tel" required maxlength="40" /></div></div>
        <div class="registration-field registration-field--full registration-field--location"><label for="delegate-origin-country">Your Location <span>*</span></label><div class="registration-location"><select id="delegate-origin-country" data-origin-country required aria-label="Country"></select><input id="delegate-origin-city" data-origin-city autocomplete="address-level2" placeholder="City" required maxlength="120" /></div><input type="hidden" name="origin_city" data-origin-value /></div>
        <div class="registration-field registration-field--arrival-date"><label for="delegate-arrival-date">Date of arrival <span>*</span></label><input id="delegate-arrival-date" name="arrival_date" type="date" required /></div>
        <div class="registration-field registration-field--arrival-time"><label for="delegate-arrival-time">Project Arrival Time <span>*</span></label><input id="delegate-arrival-time" name="arrival_time" type="time" required /></div>
        <fieldset class="registration-choice registration-choice--delegate"><legend>Airport pick-up options <span>*</span></legend><div class="registration-choice__options"><label><input type="radio" name="airport_pickup" value="Yes, I need transportation recommendations" required /><span>Yes, I need recommendations</span></label><label><input type="radio" name="airport_pickup" value="No, I will arrange my own transportation" /><span>No, I’ll arrange my own</span></label></div></fieldset>
        <div class="registration-field registration-field--departure-date"><label for="delegate-departure-date">Date of departure <span>*</span></label><input id="delegate-departure-date" name="departure_date_part" type="date" required /></div>
        <div class="registration-field registration-field--departure-time"><label for="delegate-departure-time">Projected Departure Time <span>*</span></label><input id="delegate-departure-time" name="departure_time_part" type="time" required /></div>
        <fieldset class="registration-choice registration-choice--delegate"><legend>Will logistics be required for airport drop-off? <span>*</span></legend><div class="registration-choice__options"><label><input type="radio" name="airport_dropoff" value="Yes, I need transportation recommendations" required /><span>Yes, I need recommendations</span></label><label><input type="radio" name="airport_dropoff" value="No, I will arrange my own transportation" /><span>No, I’ll arrange my own</span></label></div></fieldset>
        <fieldset class="registration-choice registration-choice--delegate"><legend>Accommodation preference <span>*</span></legend><div class="registration-choice__options"><label><input type="radio" name="accommodation_preference" value="Yes, I would like to use the discounted accommodation option" required /><span>Yes, discounted option</span></label><label><input type="radio" name="accommodation_preference" value="No, I will arrange my own accommodation" /><span>No, I’ll arrange my own</span></label></div></fieldset>
        <div class="registration-field"><label for="delegate-next-of-kin">Name of next of kin <span>*</span></label><input id="delegate-next-of-kin" name="next_of_kin_name" autocomplete="off" required maxlength="120" /></div>
        <div class="registration-field"><label for="delegate-next-of-kin-phone">Phone number of next of kin <span>*</span></label><div class="registration-phone-row"><input id="delegate-next-of-kin-phone" name="next_of_kin_phone" data-delegate-phone type="tel" autocomplete="off" required maxlength="40" /></div></div>
        <div class="registration-field registration-field--full"><label for="delegate-comments">Additional comments or special requests</label><textarea id="delegate-comments" name="comments" rows="4" maxlength="2000"></textarea></div>
      </div>
      <label class="registration-honeypot" aria-hidden="true">Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label>
      <div class="registration-submit"><button class="button button--ember" type="submit"><Icon name="arrowRight" size={17} />Submit registration</button><p data-delegate-status role="status" aria-live="polite">Fields marked * are required.</p></div>
    </form>
    <p class="registration-privacy">Your details are collected to coordinate delegate arrival and hospitality. Read our <a href="/privacy">Privacy Policy</a>.</p>
  </dialog>

  <script>
    import intlTelInput from 'intl-tel-input';
    import 'intl-tel-input/styles';

    const panel = document.querySelector('[data-delegate-panel]');
    const form = panel?.querySelector('[data-delegate-form]');
    const phoneControls = new WeakMap();

    const originCountry = form?.querySelector('[data-origin-country]');
    if (originCountry instanceof HTMLSelectElement) {
      originCountry.add(new Option('Select country', ''));
      intlTelInput.getCountryData().forEach(({ iso2, name }) => {
        const flag = [...iso2.toUpperCase()].map((char) => String.fromCodePoint(127397 + char.charCodeAt(0))).join('');
        originCountry.add(new Option(`${flag} ${name}`, name));
      });
    }

    const initializePhoneInputs = () => {
      if (!(panel instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;
      form.querySelectorAll('[data-delegate-phone]').forEach((input) => {
        if (!(input instanceof HTMLInputElement) || phoneControls.has(input)) return;
        const instance = intlTelInput(input, {
          initialCountry: 'ng', separateDialCode: true, countrySearch: true,
          dropdownParent: panel, fullscreenParent: panel,
          loadUtils: () => import('intl-tel-input/utils'),
        });
        phoneControls.set(input, instance);
        input.addEventListener('input', () => input.setCustomValidity(''));
      });
    };

    document.querySelector('[data-open-delegate-registration]')?.addEventListener('click', () => {
      if (!(panel instanceof HTMLDialogElement)) return;
      initializePhoneInputs();
      if (!panel.open) panel.showModal();
      form?.querySelector('input:not([type="radio"])')?.focus({ preventScroll: true });
      document.querySelector('[data-open-delegate-registration]')?.setAttribute('aria-expanded', 'true');
    });
    panel?.querySelector('[data-delegate-close]')?.addEventListener('click', () => {
      if (panel instanceof HTMLDialogElement) panel.close();
    });
    panel?.addEventListener('click', (event) => {
      if (event.target === panel && panel instanceof HTMLDialogElement) panel.close();
    });
    panel?.addEventListener('close', () => document.querySelector('[data-open-delegate-registration]')?.setAttribute('aria-expanded', 'false'));

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const honeypot = form.querySelector('[name="website"]');
      if (honeypot instanceof HTMLInputElement && honeypot.value.trim()) return;
      const phones = [...form.querySelectorAll('[data-delegate-phone]')].filter((input) => input instanceof HTMLInputElement);
      const normalizedPhones = {};
      for (const input of phones) {
        const instance = phoneControls.get(input);
        if (!instance) continue;
        await instance.promise;
        if (!instance.isValidNumber()) {
          input.setCustomValidity('Enter a valid phone number for the selected country.');
          input.reportValidity();
          return;
        }
        input.setCustomValidity('');
        normalizedPhones[input.name] = instance.getNumber();
      }
      const status = form.querySelector('[data-delegate-status]');
      const submit = form.querySelector('button[type="submit"]');
      const endpoint = form.dataset.endpoint || '';
      const apiKey = form.dataset.apiKey || '';
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (!endpoint || !apiKey) {
        if (status) status.textContent = 'Online submissions are being set up. Please try again later.';
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
        return;
      }
      if (status) status.textContent = 'Sending your registration…';
      const data = new FormData(form);
      const fields = Object.fromEntries([...data.entries()].filter(([key]) => key !== 'website' && key !== 'departure_date_part' && key !== 'departure_time_part' && key !== 'origin_city' && !(key in normalizedPhones)));
      const departureDate = String(data.get('departure_date_part') || '');
      const departureTime = String(data.get('departure_time_part') || '');
      const city = String(form.querySelector('[data-origin-city]')?.value || '').trim();
      const country = String(originCountry instanceof HTMLSelectElement ? originCountry.value : '').trim();
      fields.departure_at = `${departureDate}T${departureTime}`;
      fields.origin_city = `${city}, ${country}`;
      Object.assign(fields, normalizedPhones);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify(fields),
        });
        if (!response.ok) throw new Error('Registration submission failed');
        form.reset();
        if (status) status.textContent = 'Thank you. Your delegate registration has been received.';
      } catch {
        if (status) status.textContent = 'We could not send your registration just now. Please try again later or contact info@ymrglobal.org.';
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  </script>
</SiteLayout>
