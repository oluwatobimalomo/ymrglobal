                <a class="edition-story__resource" data-mixlr-link href="https://flamingnetwork.mixlr.com/" target="_blank" rel="noopener noreferrer" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-9 9v6a3 3 0 0 0 3 3h2v-8H6v5H5v-6a7 7 0 0 1 14 0v6h-1v-5h-2v8h2a3 3 0 0 0 3-3v-6a9 9 0 0 0-9-9Z"/></svg><span data-mixlr-label>Listen on Mixlr</span></a>
              </div>
            </section>
            <section class="edition-modal__gallery" aria-labelledby="edition-gallery-title" data-edition-gallery hidden>
              <div class="edition-modal__section-heading"><div><span class="section-index">THE REVIVAL · <span data-modal-year>2026</span></span><h3 id="edition-gallery-title">Gallery: Experience YMR <span data-modal-year>2026</span> in Pictures</h3></div><span class="edition-modal__gallery-mark" aria-hidden="true">YMR@10</span></div>
              <div class="edition-story__photos" data-edition-gallery-photos aria-label="Edition photo gallery">
              </div>
            </section>
          </div>
        </div>
      </dialog>

      <section class="regional-editions section-wrap" aria-labelledby="regional-title">
        <div class="regional-editions__heading"><div><span class="section-index">YMR GLOBAL</span><h2 id="regional-title">YMR: To The Ends<br /><span>of the Earth</span></h2></div><a class="text-link text-link--dark" href="/nations">Explore all nations</a></div>
        <div class="region-grid">{regions.map((region) => <a class="region-card" href={region.href} aria-label={`View ${region.title} on the YMR Nations page`} data-motion><span class="region-card__media"><img class="region-card__image" src={region.image} alt="" loading="lazy" decoding="async" /></span><span class="region-card__body"><span class="region-card__country">{region.location}</span><span class="region-card__title">{region.title}</span><span class="region-card__summary">{region.summary}</span><span class="region-card__open">View edition</span></span></a>)}</div>
      </section>

      <section class="event-guide section-wrap" id="plan-your-visit" aria-labelledby="event-guide-title">
        <div class="event-guide__heading">
          <div><span class="section-index">YMR 2026 · ATTENDEE GUIDE</span><h2 id="event-guide-title">Plan your visit.<br /><span>Come ready.</span></h2></div>
          <p>Curated questions and answers about YMR to aid your preparation and travel for the retreat</p>
        </div>
        <div class="event-guide__grid">
          <article class="event-guide__essentials" data-motion aria-labelledby="event-essentials-title">
            <span class="event-guide__edition">THE TENTH EDITION · CITY TAKERS</span>
            <h3 id="event-essentials-title">YMR 2026</h3>
            <dl class="event-guide__facts">
              <div><dt><Icon name="calendar" size={17} />Dates</dt><dd>December 26–30, 2026</dd></div>
              <div><dt><Icon name="mapPin" size={17} />Venue</dt><dd>Old Auditorium, Redemption City of God</dd></div>
              <div><dt><Icon name="globe" size={17} />Location</dt><dd>Ogun State, Nigeria</dd></div>
            </dl>
            <div class="event-guide__actions">
              <a class="button button--ember" href="https://register.ymrglobal.org/"><Icon name="calendar" size={17} />Register</a>
              <a class="event-guide__directions" href="https://www.google.com/maps/search/?api=1&amp;query=Old+Auditorium+Redemption+City+of+God+Ogun+State+Nigeria" target="_blank" rel="noopener noreferrer"><Icon name="mapPin" size={17} />Get directions</a>
            </div>
            <p class="event-guide__note">Travelling from another country? <br><a href="/delegates">Contact our Foreign Delegates Management team for support.</a></p>
          </article>
          <div class="event-guide__faq" data-motion>
            <a class="event-guide__faq-link" href="/faq">See FAQ <span aria-hidden="true"></span></a>
            <h3>Things you need to know</h3>
            <details>
              <summary>What is YMR?<span aria-hidden="true">+</span></summary>
              <p>YMR is Young Ministers’ Retreat, a gathering of believers from around the world where people are set on fire for God. Since 2017, its vision has been to raise burning kingdom giants.</p>
            </details>
            <details>
              <summary>Is YMR only for young people or ministers?<span aria-hidden="true">+</span></summary>
              <p>No. YMR is for everyone who desires to burn for God in their generation, regardless of age or church role.</p>
            </details>
            <details>
              <summary>Who is YMR for?<span aria-hidden="true">+</span></summary>
              <p>Young or old, men or women, students or workers, married or single, teenagers, young adults, and children are welcome at YMR.</p>
            </details>
            <details>
              <summary>When and where is YMR Global Festival 2026?<span aria-hidden="true">+</span></summary>
              <p>December 26–30, 2026, at the Old Auditorium, Redemption City, KM 46, Lagos–Ibadan Expressway.</p>
            </details>
            <details>
              <summary>How do I register or volunteer?<span aria-hidden="true">+</span></summary>
              <p>Register or sign up to volunteer through the <a href="https://register.ymrglobal.org/" target="_blank" rel="noopener noreferrer">official YMR registration page</a>. “Whatever you do, work at it with all your heart, as working for the Lord.” — Colossians 3:23–24.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__copy"><span class="section-index">DECEMBER 26–30, 2026</span><h2 id="closing-title">Join us at <span>YMR 2026.</span></h2><p>Come and experience worship, the word, prayer, and spiritual renewal at YMR.</p></div>
        <a class="button button--ember" href="https://register.ymrglobal.org/">Register for YMR 2026</a>
      </section>

    </main>

    <footer class="site-footer" id="contact">
      <div class="footer-main">
        <div class="footer-brand"><a class="brand brand--footer" href="#top" aria-label="Young Ministers Retreat home"><img class="brand__logo brand__logo--light" src="/images/brand/ymr-high-quality-logo.webp" alt="Young Ministers Retreat, YMR" width="1600" height="858" /><img class="brand__logo brand__logo--dark" src="/images/brand/ymr-site-logo.png" alt="" aria-hidden="true" width="2560" height="1374" /></a><p>Raising a burning generation...</p></div>
        <div class="footer-column"><h2>Explore</h2><a href="#about">About Us</a><a href="/nations">Nations</a><a href="/initiatives">Initiatives</a><a href="/testimonies">Testimonies</a><a href="/prayer-wall">Prayer Wall</a></div>
        <div class="footer-column"><h2>Get involved</h2><a href="/accommodation">Accommodation</a><a href="/delegates">International delegates</a><a href="/partner">Partner with YMR</a><a href="https://paystack.shop/pay/ymr_partners">Giving</a><a href="/counselling">Counselling</a></div>
        <div class="footer-column footer-contact"><h2>Contact</h2><a href="mailto:info@ymrglobal.org">info@ymrglobal.org</a><a href="tel:+2347048782063">+234 704 878 2063</a><a href="tel:+447881155846">+44 7881 155846</a></div>
        <div class="footer-column footer-social"><h2>Follow YMR</h2><SocialLinks /></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Young Ministers Retreat</span><span>Young Ministers Retreat Global</span><a href="/privacy">Privacy</a><a href="#top">Back to top</a></div>
    </footer>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { layout, prepare } from '@chenglou/pretext';

      const motionAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      gsap.registerPlugin(ScrollTrigger);

      const alignTextGroups = () => {
        document.querySelectorAll('[data-pretext-group]').forEach((group) => {
          const headings = [...group.querySelectorAll('[data-pretext]')];
          const measure = () => {
            headings.forEach((heading) => { heading.style.minHeight = ''; });
            const heights = headings.map((heading) => {
              const style = getComputedStyle(heading);
              const prepared = prepare(heading.textContent.trim(), `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`);
              const lineHeight = Number.parseFloat(style.lineHeight) || Number.parseFloat(style.fontSize) * 1.2;
              const result = layout(prepared, heading.getBoundingClientRect().width, lineHeight);
              heading.dataset.pretextLines = String(result.lineCount);
              return result.height;
            });
            const sharedHeight = Math.ceil(Math.max(0, ...heights));
            headings.forEach((heading) => { heading.style.minHeight = `${sharedHeight}px`; });
          };
          document.fonts.ready.then(measure);
          new ResizeObserver(measure).observe(group);
        });
      };
      alignTextGroups();

      const editionModal = document.querySelector('[data-edition-modal]');
      const editionOpeners = [...document.querySelectorAll('[data-edition-open]')];
      const modalYears = [...document.querySelectorAll('[data-modal-year]')];
      const modalThemes = [...document.querySelectorAll('[data-modal-theme]')];
      const modalFullOverview = editionModal?.querySelector('[data-modal-full-overview]');
      const modalScroll = editionModal?.querySelector('.edition-modal__scroll');
      const youtubeLink = document.querySelector('[data-youtube-link]');
      const sessionCopy = document.querySelector('[data-modal-sessions-copy]');
      const galleryPhotos = editionModal?.querySelector('[data-edition-gallery-photos]');
      const gallerySection = editionModal?.querySelector('[data-edition-gallery]');
      const highlightsSection = editionModal?.querySelector('[data-edition-highlights]');
      const highlightsGrid = editionModal?.querySelector('[data-edition-highlights-grid]');
      const mixlrLink = editionModal?.querySelector('[data-mixlr-link]');
      const mixlrLabel = editionModal?.querySelector('[data-mixlr-label]');
      const telegramLink = editionModal?.querySelector('[data-telegram-link]');
      const highlightIconPaths = {
        users: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z', 'M22 21v-2a4 4 0 0 0-3-3.87', 'M16 3.13a4 4 0 0 1 0 7.75'],
        globe: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M2 12h20', 'M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z'],
        book: ['M12 7v14', 'M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a1 1 0 0 1-1 1h-4a4 4 0 0 0-4 2 4 4 0 0 0-4-2H4a1 1 0 0 1-1-1Z'],
        mapPin: ['M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z', 'M12 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
        flame: ['M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.4-.5-2-1-3-1.5 1-3 3.5-3 5.5a5 5 0 0 0 10 0c0-2.8-1.5-5-2-6-.7-1-1.3-2-1.5-4-1 1-2 2-2 4 0 1.4.5 2.5 1 3.5'],
      };

      const renderEditionGallery = (year, photos) => {
        if (!(galleryPhotos instanceof HTMLElement)) return;
        galleryPhotos.replaceChildren();
        const hasPhotos = Array.isArray(photos) && photos.length > 0;
        if (gallerySection instanceof HTMLElement) gallerySection.hidden = !hasPhotos;
        if (!hasPhotos) return;
        photos.forEach((photo) => {
          const figure = document.createElement('figure');
          figure.className = 'edition-photo';
          const image = document.createElement('img');
          image.className = 'edition-photo__image';
          image.src = photo.src;
          image.alt = photo.alt || `A moment from YMR ${year}`;
          image.loading = 'lazy';
          image.decoding = 'async';
          const caption = document.createElement('figcaption');
          caption.textContent = photo.caption || `YMR ${year}`;
          figure.append(image, caption);
          galleryPhotos.append(figure);
        });
      };

      const renderFullOverview = (overview, theme) => {
        if (!(modalFullOverview instanceof HTMLElement)) return;
        modalFullOverview.replaceChildren();
        const blocks = overview.split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean);
        modalFullOverview.classList.toggle('edition-modal__full-overview--single', blocks.length === 1);
        let pendingHeading = '';
        blocks.forEach((block) => {
          const lines = block.split('\n').map((line) => line.trim()).filter(Boolean);
          if (!lines.length) return;
          let headingText = '';
          const firstLine = lines[0].replace(/^#{1,4}\s*/, '').replace(/\*\*/g, '').trim();
          const isShortHeading = firstLine.length > 0 && firstLine.length < 82 && !/[.!?]$/.test(firstLine);
          if (lines.length === 1 && isShortHeading && firstLine.toLowerCase() !== theme.toLowerCase()) {
            pendingHeading = firstLine;
            return;
          }
          if (lines.length > 1 && isShortHeading && firstLine.toLowerCase() !== theme.toLowerCase()) {
            headingText = firstLine;
            lines.shift();
          } else {
            headingText = pendingHeading;
          }
          pendingHeading = '';

          const article = document.createElement('article');
          article.className = 'edition-overview-block';
          if (headingText) {
            const heading = document.createElement('h4');
            const icon = document.createElement('span');
            icon.className = 'edition-overview-block__icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = '✦';
            heading.append(icon, document.createTextNode(headingText));
            article.append(heading);
          }

          let paragraphLines = [];
          let list = null;
          const flushParagraph = () => {
            if (!paragraphLines.length) return;
            const paragraph = document.createElement('p');
            paragraph.textContent = paragraphLines.join(' ');
            article.append(paragraph);
            paragraphLines = [];
          };
          lines.forEach((line) => {
            if (/^[•·-]\s/.test(line)) {
              flushParagraph();
              if (!list) {
                list = document.createElement('ul');
                article.append(list);
              }
              const item = document.createElement('li');
              item.textContent = line.replace(/^[•·-]\s*/, '');
              list.append(item);
            } else {
              paragraphLines.push(line);
            }
          });
          flushParagraph();
          modalFullOverview.append(article);
        });
      };

      const editionTimeline = document.querySelector('#edition-timeline');
      const editionScrollNav = document.querySelector('.edition-archive__controls');
      const editionScrollButtons = [...document.querySelectorAll('[data-edition-scroll]')];
      const updateEditionScrollControls = () => {
        if (!(editionTimeline instanceof HTMLElement)) return;
        const maxScroll = Math.max(0, editionTimeline.scrollWidth - editionTimeline.clientWidth);
        if (editionScrollNav instanceof HTMLElement) editionScrollNav.hidden = maxScroll <= 1;
        editionScrollButtons.forEach((button) => {
          button.disabled = button.dataset.editionScroll === 'previous'
            ? editionTimeline.scrollLeft <= 1
            : editionTimeline.scrollLeft >= maxScroll - 1;
        });
      };

      if (editionTimeline instanceof HTMLElement) {
        editionTimeline.addEventListener('scroll', updateEditionScrollControls, { passive: true });
        new ResizeObserver(updateEditionScrollControls).observe(editionTimeline);
        window.addEventListener('load', updateEditionScrollControls, { once: true });
        updateEditionScrollControls();
      }
      editionScrollButtons.forEach((button) => button.addEventListener('click', () => {
        if (!(editionTimeline instanceof HTMLElement)) return;
        const firstCard = editionTimeline.querySelector('.edition-card');
        const gap = Number.parseFloat(getComputedStyle(editionTimeline).columnGap) || 0;
        const distance = firstCard instanceof HTMLElement ? firstCard.getBoundingClientRect().width + gap : editionTimeline.clientWidth * .8;
        editionTimeline.scrollBy({ left: button.dataset.editionScroll === 'next' ? distance : -distance, behavior: motionAllowed ? 'smooth' : 'auto' });
      }));

      const openEdition = (opener) => {
        if (!(editionModal instanceof HTMLDialogElement)) return;
        const { year = '2026', theme = 'City Takers', overview = '', youtube = 'https://www.youtube.com/@PDanielOlawande', youtubeCta: providedYoutubeLabel = '', sessionSummary = '', mixlr = '', mixlrLabel: providedMixlrLabel = '', upcoming = 'false', highlights: highlightsJson = '[]', photos: photosJson = '[]' } = opener.dataset;
        let photos = [];
        let highlights = [];
        try { photos = JSON.parse(photosJson); } catch { photos = []; }
        try { highlights = JSON.parse(highlightsJson); } catch { highlights = []; }
        modalYears.forEach((label) => { label.textContent = year; });
        modalThemes.forEach((label) => { label.textContent = theme; });
        renderFullOverview(overview, theme);
        if (sessionCopy) sessionCopy.textContent = upcoming === 'true' ? 'Session recordings will be available after the retreat.' : (sessionSummary || `Watch messages and teaching from YMR ${year}.`);
        renderEditionGallery(year, photos);
        if (youtubeLink instanceof HTMLAnchorElement) youtubeLink.href = youtube;
        if (youtubeLink instanceof HTMLAnchorElement) {
          const label = providedYoutubeLabel || (youtube.includes('watch?v=') ? `Watch the YMR ${year} session on YouTube` : `Find YMR ${year} sessions on YouTube`);
          youtubeLink.setAttribute('aria-label', label);
          youtubeLink.title = label;
        }
        if (highlightsSection instanceof HTMLElement && highlightsGrid instanceof HTMLElement) {
          highlightsGrid.replaceChildren();
          highlightsSection.hidden = !highlights.length;
          if (highlights.length) {
            highlights.forEach(({ value, label, note, icon }) => {
              const card = document.createElement('article');
              card.className = 'edition-highlight';
              const iconPaths = highlightIconPaths[icon];
              if (Array.isArray(iconPaths)) {
                const iconElement = document.createElement('span');
                iconElement.className = 'edition-highlight__icon';
                iconElement.setAttribute('aria-hidden', 'true');
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.setAttribute('width', '14');
                svg.setAttribute('height', '14');
                svg.setAttribute('fill', 'none');
                svg.setAttribute('stroke', 'currentColor');
                svg.setAttribute('stroke-width', '1.8');
                svg.setAttribute('stroke-linecap', 'round');
                svg.setAttribute('stroke-linejoin', 'round');
                iconPaths.forEach((path) => {
                  const pathElement = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                  pathElement.setAttribute('d', path);
                  svg.append(pathElement);
                });
                iconElement.append(svg);
                card.append(iconElement);
              }
              const number = document.createElement('strong');
              number.textContent = value;
              const title = document.createElement('span');
              title.textContent = label;
              const detail = document.createElement('small');
              detail.textContent = note;
              card.append(number, title, detail);
              highlightsGrid.append(card);
            });
          }
        }
        if (mixlrLink instanceof HTMLAnchorElement) {
          mixlrLink.hidden = !mixlr;
          if (mixlr) mixlrLink.href = mixlr;
        }
        if (mixlrLabel) mixlrLabel.textContent = providedMixlrLabel || 'Listen on Mixlr';
        if (telegramLink instanceof HTMLAnchorElement) telegramLink.hidden = year === '2025';
        if (modalScroll instanceof HTMLElement) modalScroll.scrollTop = 0;
        if (!editionModal.open) editionModal.showModal();
        if (motionAllowed) {
          gsap.fromTo(editionModal.querySelectorAll('.edition-modal__overview, .edition-modal__highlights, .edition-modal__sessions, .edition-modal__gallery'),
            { y: 14, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: .42, stagger: .08, ease: 'power2.out', clearProps: 'transform,opacity,visibility' });
        }
      };

      editionOpeners.forEach((opener) => opener.addEventListener('click', () => openEdition(opener)));
      document.querySelector('[data-close-edition]')?.addEventListener('click', () => {
        if (editionModal instanceof HTMLDialogElement) editionModal.close();
      });
      editionModal?.addEventListener('click', (event) => {
        if (event.target === editionModal && editionModal instanceof HTMLDialogElement) editionModal.close();
      });

      if (motionAllowed) {
        const playHeroIntro = () => {
          const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
          intro.fromTo('.hero__copy > .eyebrow', { y: 16, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .55 })
            .fromTo('.hero__anniversary-mark', { y: 16, scale: .97, autoAlpha: 0 }, { y: 0, scale: 1, autoAlpha: 1, duration: .72 }, '-=.16')
            .fromTo('.hero__theme-treatment', { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .5 }, '-=.3')
            .fromTo('.hero__intro', { y: 16, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .52 }, '-=.38')
            .fromTo('.hero__actions', { y: 14, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .48 }, '-=.28')
            .fromTo('.event-strip', { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .5 }, '-=.2')
            .fromTo('.hero__visual', { y: 18, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .82, ease: 'power2.out' }, '-=.72');
        };
        if (document.documentElement.classList.contains('has-opening-sequence')) window.addEventListener('ymr:intro-complete', playHeroIntro, { once: true });
        else playHeroIntro();

        [
          ['.impact__grid', '.impact-card'],
          ['.event-guide__grid', '.event-guide__essentials, .event-guide__faq'],
          ['.about-overview', '.about-overview__copy'],
          ['.testimonies__grid', '.testimony-card'],
          ['.history__grid', '.history-card'],
          ['.convener', '.convener__portrait, .convener__content'],
          ['.principles-section__heading', 'h2'],
          ['.principles', '.principle-card'],
          ['.who__gallery', 'figure'],
          ['.initiative-grid', '.initiative-card'],
          ['.expect__grid', '.expect-card'],
          ['.photo-grid', '.photo-card'],
          ['.edition-timeline', '.edition-card'],
          ['.region-grid', '.region-card'],
        ].forEach(([trigger, items]) => {
          const group = document.querySelector(trigger);
          if (!group) return;
          gsap.fromTo(group.querySelectorAll(items), { y: 18, autoAlpha: 0 }, {
            y: 0,
            autoAlpha: 1,
            duration: .55,
            stagger: .07,
            ease: 'power2.out',
            scrollTrigger: { trigger: group, start: 'top 86%', once: true },
          });
        });

        const canvas = document.querySelector('[data-flame-scene]');
        if (canvas) {
          const startFlameScene = () => import('../scripts/flame-scene.js')
            .then(({ mountFlameScene }) => mountFlameScene(canvas, gsap))
            .catch((error) => console.warn('Decorative YMR flame scene could not start.', error));
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                observer.disconnect();
                startFlameScene();
              }
            }, { rootMargin: '120px' });
            observer.observe(canvas);
          } else {
            startFlameScene();
          }
        }
      }
    </script>
  </body>
</html>
