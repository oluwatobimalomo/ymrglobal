    <div class="opening-sequence__handoff" data-opening-handoff aria-hidden="true" hidden></div>
    <script is:inline>
      (() => {
        const intro = document.querySelector('[data-opening-sequence]');
        const skip = document.querySelector('[data-skip-opening]');
        const handoff = document.querySelector('[data-opening-handoff]');
        if (!(intro instanceof HTMLElement)) return;
        if (!document.documentElement.classList.contains('has-opening-sequence')) {
          intro.hidden = true;
          return;
        }

        let completed = false;
        let timer;
        const hideIntro = () => {
          intro.hidden = true;
          intro.style.removeProperty('display');
          intro.style.removeProperty('clip-path');
          intro.style.removeProperty('transform');
        };
        const finishIntro = () => {
          if (completed) return;
          completed = true;
          window.clearTimeout(timer);
          window.clearTimeout(window.ymrIntroFailsafeTimer);
          window.ymrIntroFailsafeTimer = undefined;
          document.documentElement.classList.remove('has-opening-sequence');
          window.dispatchEvent(new Event('ymr:intro-complete'));

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            intro.style.display = 'grid';
            intro.classList.add('is-leaving');
            window.setTimeout(hideIntro, 220);
            return;
          }

          intro.style.display = 'grid';
          intro.classList.add('is-leaving');

          if (handoff instanceof HTMLElement) {
            const mark = intro.querySelector('.opening-sequence__mark-stage');
            const bounds = mark?.getBoundingClientRect();
            const x = bounds ? bounds.left + bounds.width / 2 : window.innerWidth / 2;
            const y = bounds ? bounds.top + bounds.height / 2 : window.innerHeight / 2;
            const diameter = Math.ceil(Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)) * 2 + 60);
            handoff.style.setProperty('--handoff-x', `${x}px`);
            handoff.style.setProperty('--handoff-y', `${y}px`);
            handoff.style.setProperty('--handoff-diameter', `${diameter}px`);
            handoff.hidden = false;
            handoff.classList.add('is-active');
          }

          window.setTimeout(hideIntro, 980);
          window.setTimeout(() => {
            handoff?.classList.remove('is-active');
            if (handoff instanceof HTMLElement) handoff.hidden = true;
          }, 1550);
        };

        const handleSkip = (event) => {
          const target = event.target;
          if (!(target instanceof Element) || !target.closest('[data-skip-opening]')) return;
          event.preventDefault();
          finishIntro();
        };
        document.addEventListener('click', handleSkip, true);
        skip?.addEventListener('click', finishIntro);
        timer = window.setTimeout(finishIntro, 6000);

        // Visual polish must never prevent Skip or the timed handoff from being ready.
        try {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduceMotion && typeof Element.prototype.animate === 'function') {
            intro.querySelector('.opening-sequence__logo')?.animate(
              [
                { opacity: 0, transform: 'scale(.82) rotate(-4deg)', filter: 'blur(8px)' },
                { opacity: 1, transform: 'scale(1) rotate(0)', filter: 'blur(0)' },
              ],
              { duration: 1050, easing: 'cubic-bezier(.2, .8, .2, 1)', fill: 'both' },
            );
            intro.querySelector('.opening-sequence__eyebrow')?.animate(
              [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }],
              { duration: 400, delay: 450, easing: 'ease-out', fill: 'both' },
            );
            intro.querySelector('.opening-sequence__theme-lockup')?.animate(
              [{ opacity: 0, transform: 'translateY(13px)' }, { opacity: 1, transform: 'translateY(0)' }],
              { duration: 550, delay: 900, easing: 'ease-out', fill: 'both' },
            );
            intro.querySelector('.opening-sequence__countdown')?.animate(
              [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
              { duration: 450, delay: 1150, easing: 'ease-out', fill: 'both' },
            );
            intro.querySelector('.opening-sequence__event')?.animate(
              [{ opacity: 0, transform: 'translateY(7px)' }, { opacity: 1, transform: 'translateY(0)' }],
              { duration: 360, delay: 1370, easing: 'ease-out', fill: 'both' },
            );
          }
        } catch {}
      })();
    </script>
    <script is:inline>
      (() => {
        const intro = document.querySelector('[data-opening-sequence]');
        const orbit = intro?.querySelector('.opening-sequence__orbit-line');
        const mark = intro?.querySelector('.opening-sequence__logo img');
        if (!intro || !orbit || !mark) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const orbitDuration = reduceMotion ? 6.5 : 3.8;
        const markDuration = reduceMotion ? 4.8 : 3.2;
        const markTravel = reduceMotion ? 5 : 9;
        const markScale = reduceMotion ? 0.012 : 0.025;
        const startedAt = performance.now();

        const animateIntro = (now) => {
          if (intro.hidden || !intro.isConnected || !document.documentElement.classList.contains('has-opening-sequence')) return;
          const elapsed = now - startedAt;
          const angle = -18 + (elapsed / (orbitDuration * 1000)) * 360;
          orbit.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;

          const phase = Math.sin((elapsed / (markDuration * 1000)) * Math.PI * 2);
          mark.style.transform = `translate3d(0, ${phase * markTravel}px, 0) scale(${1 + phase * markScale})`;
          requestAnimationFrame(animateIntro);
        };

        requestAnimationFrame(animateIntro);
      })();
    </script>
