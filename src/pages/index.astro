    <script is:inline>
      (() => {
        let shouldShowIntro = true;
        try {
          shouldShowIntro = localStorage.getItem('ymr-intro-seen') !== 'true';
          if (shouldShowIntro) localStorage.setItem('ymr-intro-seen', 'true');
        } catch {}
        if (!shouldShowIntro) return;

        try {
          document.documentElement.classList.add('has-opening-sequence');
          window.ymrIntroFailsafeTimer = window.setTimeout(() => {
            document.documentElement.classList.remove('has-opening-sequence');
            const intro = document.querySelector('[data-opening-sequence]');
            if (intro instanceof HTMLElement) {
              intro.hidden = true;
              intro.style.removeProperty('display');
              intro.style.removeProperty('clip-path');
              intro.style.removeProperty('transform');
            }
            const handoff = document.querySelector('[data-opening-handoff]');
            if (handoff instanceof HTMLElement) {
              handoff.classList.remove('is-active');
              handoff.hidden = true;
            }
            window.dispatchEvent(new Event('ymr:intro-complete'));
          }, 10000);
        } catch {}
      })();
    </script>
