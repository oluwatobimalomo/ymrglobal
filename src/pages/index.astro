import '../styles/global.css';

const galleryHighlights = [1, 6, 11, 25, 54, 66].map((id) => galleryPhotos.find((photo) => photo.id === id)!);

const initiatives = [
  { number: '01', name: 'Youth Aflame Conference', short: 'YAC', detail: 'YMR expression for young professionals and those preparing to excel in their careers.', image: '/images/initiatives/youth-aflame.jpg', alt: 'Youth Aflame Conference panel on stage', href: '/initiatives#youth-aflame' },
  { number: '02', name: 'RCCG The Envoys', short: 'THE ENVOYS', detail: 'A young people church expression of RCCG, raising kingdom ambassadors.', image: '/images/initiatives/envoys.jpg', alt: 'A minister speaking with The Envoys congregation', href: 'https://rccgtheenvoys.org/', external: true },
  { number: '03', name: 'City to City Fire Conference', short: 'CITY TO CITY', detail: 'A YMR initiative that carries revival fire into cities and territories beyond the main retreat.', image: '/images/initiatives/city-to-city.jpg', alt: 'A worshipper responding at a City to City Fire Conference', href: '/initiatives#city-to-city' },
  { number: '04', name: 'YMR Samaritan', short: 'SAMARITAN', detail: 'Supporting YMR participants through education, empowerment, and health initiatives.', image: '/images/initiatives/samaritan.jpg', alt: 'Schoolchildren writing in their notebooks', href: '/initiatives#samaritan' },
];

const expectations = [
  { icon: 'music', title: 'Passionate Worship', detail: 'Join vibrant worship that ignites your spirit and releases God’s fire.', image: 'expect-worship.jpg', alt: 'A worship leader singing and lifting his hands during YMR' },
  { icon: 'book', title: 'Bible Study', detail: 'Engage in in-depth studies that reveal fresh insights from God’s Word.', image: 'expect-bible-study.jpg', alt: 'Young people listening during a YMR Bible teaching session' },
  { icon: 'hands', title: 'Intensive Prayer', detail: 'Participate in prayer sessions that spark revival and release divine fire.', image: 'expect-prayer.jpg', alt: 'A young woman praying during YMR' },
  { icon: 'flame', title: 'Release of Fire', detail: 'Encounter God’s fire, igniting your passion and empowering your service.', image: 'expect-fire.jpg', alt: 'A young man worshipping with his hands raised' },
];

const impact = [
  { value: '7+', label: 'Nations Reached', icon: 'globe' },
  { value: '20K+', label: 'Souls Saved', icon: 'heart' },
  { value: '50K+', label: 'Volunteers', icon: 'people' },
  { value: '3M+', label: 'Physical Attendees', icon: 'users' },
];

const testimonyStories = [
  {
    year: '2024',
    category: 'Academic Breakthroughs',
    icon: 'book',
    title: 'A fully funded PhD scholarship',
    detail: 'After receiving a Canadian visa, an invitation to interview for a US scholarship arrived on the way to YMR.',
  },
  {
    year: '2022–23',
    category: 'Marital Settlement',
    icon: 'heart',
    title: 'A marriage and new jobs',
    detail: 'After attending YMR 2022 as a single, one participant returned in 2023 married and with two bigger jobs.',
  },
  {
    year: '2025',
    category: 'Business Breakthrough',
    icon: 'sparkles',
    title: 'A ₦2 Million Business Grant',
    detail: 'One participant was among the beneficiaries of the business grant initiative organised by YMR in partnership with Premium Trust Bank.',
  },
];

const testimonyUrl = '/testimonies';

const principles = [
  { title: 'Rooted in the Word & Fire', icons: ['book', 'flame'], detail: 'We are grounded in Scripture and ablaze with the power of the Holy Ghost.' },
  { title: 'Rugged in Spirit', icons: ['dove'], detail: 'Through prayer, fasting, and tarrying, we cultivate discipline, purity, and supernatural boldness.' },
  { title: 'Driven by Purpose', icons: ['compass'], detail: 'With a heart for evangelism, excellence, and revival, we pursue kingdom impact with passion and power.' },
];

const telegramSermons = 'https://t.me/pdanielfireinmybones';
const editions = [
  { year: '2017', theme: 'Fire for Needed Impact', overview: `The Young Ministers Retreat (YMR) was born out of a personal spiritual habit that collided with a direct divine instruction. It began as a small, local meeting of friends in Nigeria and rapidly evolved into a global movement of youth seeking spiritual revival.

The Seed: A Personal End-of-Year Tradition (December 2017)
The foundational roots of YMR trace back to December 2017. The convener, Pastor Daniel Olawande (“PDaniel”), had a personal habit of spending the last three days of every year at the Redemption Camp to fast, pray, and seek direction for the upcoming year. Having just transitioned into full-time ministry, he decided not to do his usual retreat alone. He asked his wife and a few colleagues join him.

The simple flyer they designed went viral, and what should have been a small, intimate circle of ministers and friends outgrew their intended small eatery venue before the event even began. By late December 2017, between 700 and 1,000 young people from over 24 different denominations converged at the camp under the inaugural theme, “Fire for Needed Impact.” The overwhelming spiritual hunger of that first crowd proved that there was a massive vacuum for revival among the youth.`, youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202017', youtubeLabel: 'Find YMR 2017 sessions on YouTube', sessionSummary: '', highlights: [
    { value: '721', label: 'On-site participants', note: 'At Teens Auditorium, RCCG Camp.', icon: 'users' },
    { value: '1,800+', label: 'Online participants', note: 'Joined the 2017 retreat online.', icon: 'globe' },
    { value: '9', label: 'Speakers', note: 'Teaching on ministry and the Christian life.', icon: 'book' },
    { value: '37%', label: 'From outside Lagos', note: 'Participants travelled from other locations.', icon: 'mapPin' },
    { value: '54% / 46%', label: 'Male / female participants', note: 'Participant breakdown.', icon: 'users' },
    { value: '72 hours', label: 'Prayer and fasting', note: 'The retreat included a 3-day dry fast.', icon: 'flame' },
  ], flyer: '/images/editions/ymr-2017-fire-needed-impact.jpg' },
  { year: '2018', theme: 'Explosive Exploits', overview: `Following a profound vision in Dubai where Pastor Daniel Olawande saw giant spiritual figures emerging from fire, the event shifted from a casual meeting of friends to an intentional training camp. Over 4,000 youth attended for 72 hours of uninterrupted fasting and prayer under the banner of "Explosive Exploits".

Pastor Daniel delivered the charge “The Mandate of the Giants”. Guest youth ministers emphasized the heavy price of spiritual stature and the importance of prayer endurance.`, youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202018', youtubeLabel: 'Find YMR 2018 sessions on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2018-explosive-exploits.jpeg' },
  { year: '2019', theme: 'FIRE TO TAKE THE CITY', overview: `The 2019 edition of the Young Ministers’ Retreat (YMR), convened by P. Daniel Olawande, was centred on the theme Fire to Take the City. The retreat carried a burden to raise a generation of believers who would be ignited by the fire of God and equipped to influence their cities for Jesus Christ.

The vision behind the theme was that spiritual encounters should produce tangible expressions of faith beyond the retreat. Believers were called to prepare themselves spiritually and actively participate in spreading the gospel, winning souls, and advancing God’s Kingdom.

Spiritual Encounters and Expectations
The retreat emphasised several areas of spiritual growth and transformation, including salvation and restoration, baptism in the Holy Spirit, divine direction, spiritual empowerment, renewed intimacy with God, and preparation for kingdom assignments. Healing, miracles, and supernatural encounters were also highlighted among the expectations communicated in the retreat’s promotional materials.

These emphases reflected the desire to see believers strengthened in their faith, equipped for service, and prepared to fulfil their God-given assignments.

The Message Behind the Theme
Fire to Take the City communicated a call to move beyond personal spiritual experiences into active kingdom service. The vision was to raise believers who would carry the presence of God into their communities, workplaces, and other spheres of influence, becoming effective witnesses of Jesus Christ.

The retreat emphasised that taking a city requires preparing people who are ready to act, particularly through evangelism and the proclamation of the gospel.`, youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202019', youtubeLabel: 'Find YMR 2019 sessions on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2019-fire-to-take-the-city.jpeg', landscape: true },
  { year: '2020', theme: 'GO IN THIS THY MIGHT', overview: `The 2020 edition of the Young Ministers’ Retreat (YMR), convened by P. Daniel Olawande, was themed “Go in This Thy Might,” drawn from Judges 6:14.

The theme emphasised the need for believers to recognise the strength and empowerment God has given them and step forward to fulfil their divine assignments. It was a call to move beyond spiritual preparation into action, trusting God to equip them for the work ahead.

Teachings by P. Daniel Olawande (“In What Might”), Pastor Chingtok Ishaku (“Go in This Thy Might”), and Apostle Michael Orokpo (“The Might of Concentration”) called attendees to fulfil their assignments in God’s strength. Orokpo emphasised consecration through prayer, holiness, sacrifice, and a life yielded to God.

Spiritual Emphasis and Expected Encounters
The retreat focused on spiritual empowerment, wisdom, divine direction, the work of the Holy Spirit, and the practical application of faith. Participants were encouraged to develop the spiritual capacity and understanding necessary to fulfil their God-given assignments. The teachings also addressed practical areas of life, including financial wisdom, family, and responding to God’s leading.`, youtube: 'https://www.youtube.com/watch?v=QPSInlH0ETo', youtubeLabel: 'Watch YMR 2020 on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2020-go-in-this-thy-might.jpeg' },
  { year: '2021', theme: 'Weapons of War', overview: `The 2021 edition of the Young Ministers’ Retreat was centred on a call to raise believers who understand their identity and responsibility in God’s kingdom. Under the theme Weapons of War, P. Daniel Olawande emphasised that believers are not merely called to salvation, but are also God’s instruments for advancing His kingdom and confronting the works of darkness.

This vision was reflected in the Heaven’s Defence Academy (HAD), which focused on raising and equipping believers for their spiritual assignment and influence in society.

The retreat featured teachings on The Authority of the Believer by Bishop Francis Wale Oke and The Prophetic Church by Apostle Tomi Arayomi, alongside a worship session led by Dunsin Oyekan.

Participants also shared testimonies of remarkable personal experiences, including reported healings from long-term anaemia, restored vision, improved speech, and restored hearing.

The message of Weapons of War was a call to spiritual preparation, consecration, and responsibility, reminding young ministers that they have a part to play in advancing God’s kingdom in their generation.`, youtube: 'https://www.youtube.com/watch?v=tYB01vtOl7o', youtubeLabel: 'Watch YMR 2021 on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2021-weapons-of-war.jpeg' },
  { year: '2022', theme: 'Witnesses', overview: `Under the theme Witnesses, P. Daniel Olawande expressed his desire to see a generation of believers who would boldly stand for God wherever they found themselves, carrying the fullness of His power and presence. He envisioned raising men and women who would not only believe in Christ but also become living expressions of His kingdom in their everyday lives.

The retreat featured teachings from several ministers, including P. Daniel Olawande, who ministered on Witnesses and The Supernatural Witnesses. Other messages included Living Witnesses and Manifestation as a Witness by Pastor Sola Osunmakinde, The Prophetic Church—no, The Witnesses by Prophet Tomi Arayomi, and Are You Sendable? By Rev. Samson Ajetumobi. Pastor Chingtok Ishaku also ministered on Witnesses in two sessions.

Beyond the spiritual sessions, the 2022 edition expanded its reach by introducing specialised classes in areas such as career development, government, politics, cybersecurity, entrepreneurship and financial growth.

The retreat also featured worship sessions led by ministers including Nathaniel Bassey, Sunmisola Agbebi and Paul Tomisin. It called believers beyond simply identifying as Christians to becoming visible witnesses of Christ through their lives, service and influence in their generation`, youtube: 'https://www.youtube.com/watch?v=2liacNFtt9I', youtubeLabel: 'Watch YMR 2022 on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2022-witnesses.jpeg' },
  { year: '2023', theme: 'The Rain', overview: `The 2023 Young Ministers’ Retreat was themed The Rain, a call to experience more of God’s presence and power. The vision was to see a generation of believers encounter God in a way that would leave a lasting impact on their lives and ministries.

Announcing the theme, P. Daniel Olawande said, “When you’re coming, you won’t need to bring an umbrella, but you’ll be wet because the glory and power of God is going to rain heavily on you!” His words captured the expectation for the retreat and the outpouring of God’s presence that it was built around.

Held from December 27 to 30, 2023, at the Old Auditorium, Redemption Camp, the retreat featured ministers including Pastor E.A. Adeboye, Pastor J.T. Kalejaiye, Rev. Samson Ajetomobi, Rev. Fola Achudume, Pastor Isaac Oyedepo, Pastor Bolaji Idowu, Pastor Olalekan Julius and Pastor Tosin Okunloye.

The ministers taught on different aspects of the theme. Pastor E.A. Adeboye ministered on The Rain, while P. Daniel Olawande spoke on When the Heavens Are Open, Things You Must Do for a Heaven to Open, The Man That Makes the Rain to Fall and Prayer Rain.

Other messages included The Rain of God’s Mercy by Rev. Fola Achudume, The Rain of Anointing by Pastor J.T. Kalejaiye, Mount Carmel: The Fire and the Rain by Pastor Isaac Oyedepo, The Essence of the Rain by Pastor Tosin Okunloye, and The New Skin for the Rain by Pastor Nifemi Olawande. Rev. Samson Ajetomobi also ministered on The Rain, while Pastor Olalekan Julius taught on How to Prepare for the Rain.

Worship was also a major part of the retreat, with ministrations from Dunsin Oyekan, Theophilus Sunday, Ebuka Songs and BBO.

The 2023 edition reminded participants that the rain was not just about what they would experience during the retreat, but also about what God would do in and through them afterwards. The call was to receive from God and carry His presence into their lives, ministries and the places He had called them to serve.`, youtube: 'https://www.youtube.com/watch?v=YuhIZZkPiUw', youtubeLabel: 'Watch YMR 2023 on YouTube', sessionSummary: '', flyer: '/images/editions/ymr-2023-the-rain.jpeg', landscape: true },
  { year: '2024', theme: 'Floodgates', overview: `What does it mean to experience an outpouring of God’s Spirit, and what does it take to sustain that experience? These were some of the ideas at the heart of the 2024 Young Ministers’ Retreat, themed Floodgates.

The theme was presented as a prophetic declaration of an unusual outpouring of God’s blessings, revival and breakthroughs. P. Daniel Olawande and the organising team envisioned a retreat where young believers would grow in their hunger for God, experience His presence and receive the spiritual strength needed to fulfil their assignments.

Held from December 26 to 30, 2024, at the Old Auditorium, Redemption City, Ogun State, the retreat brought together young believers from different places for days of prayer, fasting, worship and teachings. A major part of the retreat was 72 hours of prayer, fasting and fellowship, creating time for participants to seek God beyond the regular sessions.

One of the notable moments was the ministry of Pastor E.A. Adeboye on December 27. Speaking from Ephesians 5:18, he challenged the young ministers not to become comfortable with their present experience of the Holy Spirit. He explained that just as a person cannot remain drunk without taking more wine, believers must continually seek to be filled with the Spirit. He also shared personal experiences of God’s power in ministry and challenged the young ministers to desire a fresh manifestation of that power in their own lives and ministries.

P. Daniel Olawande also led a series of teachings titled Floodgates of the Spirit of God, delivered in three parts, and The Price for the Flood. These sessions addressed the work of the Holy Spirit and the spiritual preparation required of those who desire to experience His outpouring.

Worship was another important part of the retreat, with ministrations from Pastor Nathaniel Bassey, Dunsin Oyekan, Tee Worship, BBO, Naomi David and Precious Worship. Their sessions provided moments for participants to worship, pray and seek God together.

The 2024 edition carried a message that went beyond receiving an encounter at a retreat. Through the teachings, prayers and worship, young ministers were challenged to desire more of the Holy Spirit and to make room for His work in their everyday lives and ministries. Floodgates was a call to a generation to seek God deeply and become vessels through which His power and presence could be made known.`, youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202024%20Flood%20Gates', youtubeLabel: 'Find YMR 2024 sessions on YouTube', sessionSummary: '', highlights: [
    { value: '281,003', label: 'Estimated participants', note: 'In person and online.' },
    { value: '294,506', label: 'Livestream views', note: 'Combined views across the retreat’s livestream sessions.' },
    { value: '5 days', label: 'Retreat programme', note: 'December 26–30, 2024, at Redemption City.' },
    { value: '5 platforms', label: 'Livestream coverage', note: 'Dove TV, YouTube, Mixlr, Facebook Live, and Instagram Live.' },
    { value: '4+ countries', label: 'International delegates', note: 'Including the UK, Ghana, Benin Republic, and Germany.' },
    { value: 'Thousands', label: 'Volunteers', note: 'Teams served across core and specialist departments.' },
  ], flyer: '/images/editions/ymr-2024-flood-gates.jpeg', photos: [
    { src: '/images/gallery/ymr-2024/ymr-2024-worship.webp', alt: 'A worship leader singing during YMR 2024', caption: 'Worship and ministry' },
    { src: '/images/gallery/ymr-2024/ymr-2024-teaching.webp', alt: 'A minister teaching during a YMR 2024 session', caption: 'Teaching the Word' },
    { src: '/images/gallery/ymr-2024/ymr-2024-crowd.webp', alt: 'Retreat participants attending a YMR 2024 session', caption: 'Together at YMR 2024' },
  ] },
  { year: '2025', theme: 'The New Army', overview: `This year, the retreat brought together participants from across Nigeria and International delegates in what represents the largest edition of YMR to date, with over 300,000 people attending physically across the duration of the event. The retreat maintained its established annual structure; spanning prayer, worship, word sessions, evangelism, children and teen programming, counselling, and testimony documentation, while introducing significant operational improvements including a battalion-based participant classification model, a QR code-driven registration system, and expanded multi-platform live production coverage.`, youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202025%20The%20New%20Army', youtubeLabel: 'Find YMR 2025 sessions on YouTube', sessionSummary: '', mixlr: 'https://flamingnetwork.mixlr.com/', mixlrLabel: 'Listen to Flaming Network on Mixlr', highlights: [
    { value: '300,000+', label: 'Estimated attendees', note: 'Field estimate across the five days.' },
    { value: '39,409', label: 'Registered participants', note: 'Registered through the QR-code system.' },
    { value: '1,499', label: 'New converts', note: 'During four days of counselling.' },
    { value: '608,500', label: 'YouTube views', note: 'Approximate total across two channels.' },
    { value: '5,000+', label: 'Attendees mobilised', note: '33 mission buses served 23 locations.' },
    { value: '944', label: 'Patients treated', note: 'At three medical stations.' },
  ], flyer: '/images/editions/ymr-2025-the-new-army.jpeg', photos: [
    { src: '/images/gallery/ymr-2025/ymr-2025-stage.webp', alt: 'A minister sharing a message on stage at YMR 2025', caption: 'Messages that equip' },
    { src: '/images/gallery/ymr-2025/ymr-2025-worship.webp', alt: 'Retreat participants worshipping at YMR 2025', caption: 'Worship at YMR 2025' },
    { src: '/images/gallery/ymr-2025/ymr-2025-prayer-walk.webp', alt: 'YMR 2025 participants on a prayer walk', caption: 'Prayer in the city' },
  ] },
  { year: '2026', theme: 'City Takers', overview: 'The tenth-anniversary retreat is set for December 26–30, 2026, at Redemption City. City Takers is the theme for this upcoming edition.', youtube: 'https://www.youtube.com/@PDanielOlawande/search?query=YMR%202026%20City%20Takers', upcoming: true, flyer: '/images/brand/ymr-2026-city-takers-flyer.jpg' },
];

const editionsWithPhotos = editions.map((edition) => ({
  ...edition,
  photos: edition.photos ?? editionPhotosByYear[edition.year] ?? [],
}));

const regions = [
  { id: 'canada', title: 'YMR Canada', location: 'Canada', href: '/nations#canada', image: 'https://i.ytimg.com/vi/n8wkl0ziroc/hqdefault.jpg', alt: 'A moment from the YMR Canada edition', summary: 'A Canadian expression of YMR, bringing young ministers together for worship, prayer, and teaching while strengthening Christian leadership.' },
  { id: 'uk', title: 'YMR UK', location: 'Manchester, United Kingdom', href: '/nations#united-kingdom', image: 'https://i.ytimg.com/vi/hfU2VITljWc/hqdefault.jpg', alt: 'A moment from the YMR UK Manchester edition', summary: 'Manchester welcomed young ministers for worship, prophetic teaching, prayer, and commissioning.' },
  { id: 'usa', title: 'YMR USA', location: 'Minnesota, United States', href: '/nations#united-states', image: 'https://i.ytimg.com/vi/5wqWM_j8Iq4/hqdefault.jpg', alt: 'A moment from the YMR USA Minnesota edition', summary: 'Young ministers met in Minnesota for worship, intercession, teaching, and leadership empowerment.' },
];
