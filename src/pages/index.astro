                <a class="edition-story__resource edition-story__resource--icon" data-youtube-link href="https://www.youtube.com/@PDanielOlawande/search?query=YMR%202026%20City%20Takers" target="_blank" rel="noopener noreferrer" aria-label="Find YMR sessions on YouTube" title="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6z"/></svg></a>
