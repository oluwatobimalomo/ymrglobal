# Create a Formspree form and use its public form ID here to enable newsletter signup.
PUBLIC_FORMSPREE_FORM_ID=

# Supabase project settings. The publishable key is safe to expose in the browser
# only when the database tables have the RLS policies in supabase/schema.sql.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use a separate Formspree form for international delegate registrations.
# Without an ID, the delegate form opens an email draft as a fallback.
PUBLIC_INTERNATIONAL_DELEGATES_FORM_ID=
